{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/research", "permanent": false }
  ],
  "rewrites": [
    { "source": "/research/(.*)", "destination": "/index.html" },
    { "source": "/research", "destination": "/index.html" }
  ]
}
