{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/research", "permanent": false }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/research/(.*)", "dest": "/index.html" },
    { "src": "/research", "dest": "/index.html" }
  ]
}
