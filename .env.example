# ==============================================================================
# Jhelum Labs Research — Environment Variables & Secrets
# ==============================================================================
# IMPORTANT:
# 1. Do NOT commit your actual .env file to git! (.env is already in .gitignore)
# 2. To activate real Google OAuth and Email Login/Signup:
#    - Copy this file: `cp .env.example .env`
#    - Fill in the values below from your Firebase Console.
#
# HOW TO GET THESE KEYS IN 2 MINUTES:
# 1. Go to https://console.firebase.google.com/ and create a free project (e.g. "jhelum-labs").
# 2. In the left sidebar, click "Build" -> "Authentication" -> "Get Started".
# 3. Under the "Sign-in method" tab:
#    - Click "Email/Password" -> Toggle "Enable" -> Save.
#    - Click "Google" -> Toggle "Enable" -> Pick your support email -> Save.
# 4. In Project Settings (gear icon at top left) -> "General" tab:
#    - Scroll down to "Your apps" -> click the Web icon `</>` to register a web app.
#    - Copy the configuration object values into the variables below.
# 5. Under "Authentication" -> "Settings" -> "Authorized domains":
#    - Add `localhost` (already added by default)
#    - Add your production domain (e.g. `jhelumlabs.in`, `*.vercel.app`)
# ==============================================================================

# Firebase Web App Credentials
PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
