---
interface Logo {
  name: string
  imgLight: string      // mark shown on light backgrounds
  imgDark?: string      // mark shown on dark backgrounds (falls back to imgLight)
  styleLight?: string   // optional per-theme tweak (e.g. invert mono glyphs)
  styleDark?: string
}

interface Props {
  text?: string
  logos?: Logo[]
  mode?: 'text' | 'logos'
}

const {
  text = 'Open Research · Jhelum Labs · W-1.1 · W-1.2 · ',
  logos = [],
  mode = 'text',
} = Astro.props

const copies = Array.from({ length: 8 })
---
<section class="sv" aria-label="scrolling marquee" data-mode={mode}>

  {mode === 'logos' ? (
    /* ── Logo strip — two rows scrolling opposite directions ── */
    <>
      <div class="sv-line">
        <div class="sv-track sv-track--fwd" data-direction="1">
          {copies.map(() => logos.map((logo) => (
            <span class="sv-logo-item">
              <img
                class="sv-logo-img sv-logo-light"
                src={logo.imgLight}
                style={logo.styleLight}
                alt={logo.name}
                width="48"
                height="48"
                loading="lazy"
              />
              <img
                class="sv-logo-img sv-logo-dark"
                src={logo.imgDark ?? logo.imgLight}
                style={logo.styleDark}
                alt=""
                width="48"
                height="48"
                loading="lazy"
              />
              <span class="sv-logo-name">{logo.name}</span>
            </span>
          )))}
        </div>
      </div>
      <div class="sv-line">
        <div class="sv-track sv-track--rev" data-direction="-1">
          {copies.map(() => logos.map((logo) => (
            <span class="sv-logo-item">
              <img
                class="sv-logo-img sv-logo-light"
                src={logo.imgLight}
                style={logo.styleLight}
                alt=""
                width="48"
                height="48"
                loading="lazy"
              />
              <img
                class="sv-logo-img sv-logo-dark"
                src={logo.imgDark ?? logo.imgLight}
                style={logo.styleDark}
                alt=""
                width="48"
                height="48"
                loading="lazy"
              />
              <span class="sv-logo-name">{logo.name}</span>
            </span>
          )))}
        </div>
      </div>
    </>
  ) : (
    /* ── Text strip — two rows scrolling opposite directions ── */
    <>
      <div class="sv-line">
        <div class="sv-track sv-track--fwd" data-direction="1">
          {copies.map(() => <span class="sv-text-item">{text}</span>)}
        </div>
      </div>
      <div class="sv-line">
        <div class="sv-track sv-track--rev" data-direction="-1">
          {copies.map(() => <span class="sv-text-item">{text}</span>)}
        </div>
      </div>
    </>
  )}

</section>

<style>
.sv {
  overflow: hidden;
  padding: 22px 0;
  background: color-mix(in srgb, var(--surface) 55%, transparent);
  user-select: none;
  /* Soft fade at both edges so the marquee doesn't hard-clip. */
  -webkit-mask-image: linear-gradient(to right, transparent 0, black 6%, black 94%, transparent 100%);
  mask-image: linear-gradient(to right, transparent 0, black 6%, black 94%, transparent 100%);
}

.sv-line {
  overflow: hidden;
  white-space: nowrap;
}

.sv-track {
  display: inline-flex;
  align-items: center;
  width: max-content;
  will-change: transform;
}

/* ── Text mode ── */
.sv-text-item {
  display: block;
  padding-right: 2rem;
  color: var(--text-soft);
  font-family: var(--font-sans);
  font-size: clamp(0.78rem, 1.4vw, 1.05rem);
  font-weight: 600;
  letter-spacing: 0.04em;
  line-height: 1.6;
  text-transform: uppercase;
}

/* ── Logo mode ── */
.sv-logo-item {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  padding: 0 3.6rem 0 0;
}

.sv-logo-img {
  width: 48px;
  height: 48px;
  object-fit: contain;
  flex-shrink: 0;
  /* Monochrome "funded by" strip: every mark renders in soft gray. */
  filter: grayscale(1) contrast(.92);
  opacity: .55;
}

/* Show correct logo per theme */
.sv-logo-light { display: block; }
.sv-logo-dark  { display: none;  }

:root[data-theme='dark'] .sv-logo-light { display: none;  }
:root[data-theme='dark'] .sv-logo-dark  { display: block; }

.sv-logo-name {
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  /* Muted gray, matching the gray marks (funded-by strip look). */
  color: color-mix(in srgb, var(--text) 46%, transparent);
  white-space: nowrap;
}

/* Separator dot between items */
.sv-logo-item::after {
  content: '·';
  padding-left: 3.6rem;
  color: var(--muted);
  font-size: 1.2rem;
}
.sv-logo-item:last-child::after { display: none; }

@media (prefers-reduced-motion: reduce) {
  .sv {
    -webkit-mask-image: none;
    mask-image: none;
  }
  .sv-line:nth-child(2) { display: none; }
}
</style>

<script>
  document.querySelectorAll<HTMLElement>('.sv').forEach((section) => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const tracks = section.querySelectorAll<HTMLElement>('.sv-track')

    tracks.forEach((track) => {
      const dir = Number(track.dataset.direction ?? 1)
      let pos = 0
      let lastScroll = window.scrollY
      let velocity = 0
      let lastTime = performance.now()
      let paused = false
      let raf: number

      // Cursor over the strip parks the marquee; leaving lets it drift again.
      section.addEventListener('mouseenter', () => { paused = true }, { passive: true })
      section.addEventListener('mouseleave', () => { paused = false }, { passive: true })

      const onScroll = () => {
        velocity = window.scrollY - lastScroll
        lastScroll = window.scrollY
      }
      window.addEventListener('scroll', onScroll, { passive: true })

      // Under reduced motion, leave the strip static (no rAF loop).
      if (reduceMotion) {
        track.style.transform = 'translate3d(0, 0, 0)'
        return
      }

      const animate = (time: number) => {
        const delta = Math.min((time - lastTime) / 1000, 0.05)
        lastTime = time
        velocity *= 0.9
        if (!paused) {
          pos += dir * (118 + Math.abs(velocity) * 12) * delta
        }

        const halfWidth = track.scrollWidth / 2
        if (pos > halfWidth)  pos -= halfWidth
        if (pos < -halfWidth) pos += halfWidth

        track.style.transform = `translate3d(${pos}px, 0, 0)`
        raf = requestAnimationFrame(animate)
      }

      raf = requestAnimationFrame(animate)

      new MutationObserver(() => {
        if (!document.contains(section)) {
          cancelAnimationFrame(raf)
          window.removeEventListener('scroll', onScroll)
        }
      }).observe(document.body, { childList: true, subtree: true })
    })
  })
</script>
