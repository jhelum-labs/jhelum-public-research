---
import { SITE } from '../lib/site.js'
const { currentPath = '/' } = Astro.props
const links = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
]
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Jhelum Labs home">
      <svg viewBox="0 170 650 630" role="img" aria-label="Jhelum Labs logo" width="44" height="44"><g fill="#2a6cf5"><polygon points="152,310 306,310 335,344 176,344 49,611 82,611 196,372 358,372 394,413 228,413 124,628 0,628"/><polygon points="396,185 627,472 553,598 497,606 576,473 388,240 370,266 537,477 458,611 402,620 482,485 326,289"/><polygon points="203,513 295,651 570,614 633,720 236,780 146,640 168,592 258,729 589,683 572,655 275,697 183,559"/></g><path d="M322 443H362V538C362 575 340 592 308 592C295 592 290 590 290 590L272 560H322Z" fill="var(--mark-j)"/></svg>
    </a>
    <button class="menu-button" data-menu-button aria-label="Toggle menu" aria-expanded="false">Menu</button>
    <nav aria-label="Primary navigation">
      {links.map((link) => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}
      <a class="button button-small" href={SITE.demo.url}>{SITE.demo.label}</a>
      <button class="theme-button" data-theme-toggle type="button" aria-label="Toggle colour theme">◐</button>
    </nav>
  </div>
</header>
