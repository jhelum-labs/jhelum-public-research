---
import { SITE } from '../lib/site.js'
const { currentPath = '/' } = Astro.props
const links = [
  { href: '/research', label: 'Research' },
  { href: '/#models', label: 'Models' },
  { href: '/#lineage', label: 'Lineage' },
  { href: '/about', label: 'Company' },
  { href: '/contact', label: 'Contact' },
]
---
<header class="site-header">
  <div class="shell header-inner">
    <div class="header-left">
      <a class="brand" href="/" aria-label="Jhelum Labs home">
        <svg viewBox="0 170 650 630" role="img" aria-label="Jhelum Labs logo" width="34" height="34" class="brand-logo-svg"><g fill="#2a6cf5"><polygon points="152,310 306,310 335,344 176,344 49,611 82,611 196,372 358,372 394,413 228,413 124,628 0,628"/><polygon points="396,185 627,472 553,598 497,606 576,473 388,240 370,266 537,477 458,611 402,620 482,485 326,289"/><polygon points="203,513 295,651 570,614 633,720 236,780 146,640 168,592 258,729 589,683 572,655 275,697 183,559"/></g><path d="M322 443H362V538C362 575 340 592 308 592C295 592 290 590 290 590L272 560H322Z" fill="var(--mark-j)"/></svg>
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {links.map((link) => (
          <a
            href={link.href}
            class={currentPath === link.href ? 'nav-link active' : 'nav-link'}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="header-actions">
      <a class="btn-openai-pill" href={SITE.cta.url}>
        <span>{SITE.cta.label}</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <button class="theme-toggle-btn" data-theme-toggle type="button" aria-label="Toggle colour theme">
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button class="menu-button" data-menu-button aria-label="Toggle menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div class="mobile-nav-panel">
    <div class="shell">
      {links.map((link) => (
        <a
          href={link.href}
          class={currentPath === link.href ? 'mobile-nav-link active' : 'mobile-nav-link'}
        >
          {link.label}
        </a>
      ))}
      <a class="btn-openai-pill mobile-cta" href={SITE.cta.url}>
        {SITE.cta.label} →
      </a>
    </div>
  </div>
</header>
