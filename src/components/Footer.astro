---
import { SITE } from '../lib/site.js'
const year = new Date().getFullYear()
---
<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand-col">
      <a class="footer-brand" href="/" aria-label="Jhelum Labs home">
        <img src="/logo.png" alt="Jhelum Labs" class="brand-logo-img" width="36" height="36" />
        <span class="brand-text">Jhelum <b aria-hidden="true">\</b>abs</span>
      </a>
      <p class="footer-tagline">{SITE.tagline} for foundational AI systems.</p>
      <div class="footer-status-pill">
        <span class="status-dot"></span>
        <span>Weights verified · Apache-2.0</span>
      </div>
    </div>
    <div class="footer-col">
      <h3>Research</h3>
      <a href="/research">All Publications</a>
      <a href="/research/w-1.1-final-architecture">W-1.1 Architecture</a>
      <a href="/research/w-1.1-project-instruct">Project Instruct</a>
      <a href="/research/w-1.2-architecture">W-1.2 Roadmap</a>
      <a href="/#lineage">Model Lineage</a>
    </div>
    <div class="footer-col">
      <h3>Models & Weights</h3>
      <a href="/#models">Model Program Index</a>
      <a href={SITE.weightsUrl} download>Download Safetensors (493 MB)</a>
      <a href={SITE.githubUrl} target="_blank" rel="noreferrer">GitHub Organization ↗</a>
      <a href="/research/w-1.1-final">Final Release Report</a>
    </div>
    <div class="footer-col">
      <h3>Company & Safety</h3>
      <a href="/about">About Jhelum Labs</a>
      <a href="/about#safety">Safety & Alignment</a>
      <a href="/contact">Contact Research Team</a>
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms of Service</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <div class="footer-copy">
      © {year} {SITE.name}. Open research and model documentation.
    </div>
    <div class="footer-legal">
      <span>{SITE.license} Open Source License</span>
      <span class="dot-sep">·</span>
      <a href="/privacy">Privacy</a>
      <span class="dot-sep">·</span>
      <a href="/terms">Terms</a>
    </div>
  </div>
</footer>
