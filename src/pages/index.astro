---
import Page from '../components/Page.astro'
import { SITE } from '../lib/site.js'
import { allPublications, formatDate } from '../lib/research.js'

const recent = allPublications.slice(0, 5)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  email: SITE.contactEmail,
  sameAs: SITE.githubUrl ? [SITE.githubUrl] : [],
}
---
<Page currentPath="/" title="Jhelum Labs — Research and Deployment" description="Jhelum Labs is an independent AI research organization building advanced language models." jsonLd={jsonLd}>

  <!-- HERO — Anthropic style: straight into big headline, no logo repeated -->
  <section class="hi-hero">
    <div class="shell">

      <!-- Anthropic-style full-width bold paragraph headline -->
      <div class="hi-headline-wrap">
        <p class="hi-headline">
          <strong>Building advanced AI. Advancing research. Prioritizing safety.</strong>
          {' '}Jhelum Labs is an independent AI research and development organization
          focused on building advanced language models and reliable, production-ready
          systems. Our work spans large language models, AI safety, alignment,
          evaluation and responsible deployment — making powerful AI more accessible.
        </p>
      </div>

      <div class="hi-actions">
        <a class="hi-btn-primary" href="/research">Explore research</a>
        <a class="hi-btn-ghost" href="/playground">Try W-1.1 →</a>
      </div>

    </div>
  </section>

  <!-- GRADIENT BANNER -->
  <section class="hi-banner">
    <a href="/playground" class="hi-banner-link">
      <div class="hi-banner-bg"></div>
      <div class="hi-banner-inner shell">
        <div class="hi-banner-tag">
          <span class="hi-banner-dot"></span>
          W-1.1 · Open Weights
        </div>
        <h2 class="hi-banner-title">W-1.1</h2>
        <p class="hi-banner-sub">Our first 123M-parameter language model, trained from scratch.</p>
        <span class="hi-banner-cta">Read more →</span>
      </div>
    </a>
  </section>

  <!-- LEARN MORE — 4-card grid like Anthropic -->
  <section class="hi-learn shell">
    <p class="hi-learn-label">Learn more</p>
    <div class="hi-learn-grid">
      <a class="hi-card" href="/research?type=Research+Paper">
        <div class="hi-card-img hi-card-img--arch"><div class="hi-card-img-inner"></div></div>
        <div class="hi-card-cat">Architecture</div>
        <h3 class="hi-card-title">W-1.1 Architecture</h3>
        <p class="hi-card-desc">Decoder-only Transformer with RoPE, RMSNorm, SwiGLU and tied embeddings — 123M parameters trained from scratch.</p>
      </a>
      <a class="hi-card" href="/research/w-1.1-project-instruct">
        <div class="hi-card-img hi-card-img--align"><div class="hi-card-img-inner"></div></div>
        <div class="hi-card-cat">Alignment</div>
        <h3 class="hi-card-title">Project Instruct</h3>
        <p class="hi-card-desc">Instruction-tuning on 300K Q&A pairs. W-1.1 learns to follow instructions across diverse task types.</p>
      </a>
      <a class="hi-card" href="/research/w-1.2-architecture">
        <div class="hi-card-img hi-card-img--w12"><div class="hi-card-img-inner"></div></div>
        <div class="hi-card-cat">W-1.2 Roadmap</div>
        <h3 class="hi-card-title">Next generation</h3>
        <p class="hi-card-desc">353M parameters, grouped-query attention, 50K vocab, 4,096-token context, 8B token training target.</p>
      </a>
      <a class="hi-card" href="/research/w-1.1-final">
        <div class="hi-card-img hi-card-img--safety"><div class="hi-card-img-inner"></div></div>
        <div class="hi-card-cat">Safety</div>
        <h3 class="hi-card-title">Model safety</h3>
        <p class="hi-card-desc">Every release includes explicit experimental-use warnings, benchmark transparency and SHA-256 weight verification.</p>
      </a>
    </div>
  </section>

  <!-- LATEST RESEARCH -->
  <section class="hi-pubs shell">
    <div class="hi-pubs-head">
      <h2 class="hi-pubs-title">Latest research</h2>
      <a href="/research" class="hi-pubs-more">View all →</a>
    </div>
    <div class="hi-pubs-list">
      {recent.map((pub) => (
        <a class="hi-pub-row" href={pub.articlePath}>
          <div class="hi-pub-left">
            <span class="hi-pub-type">{pub.type === 'Research Paper' ? 'Research' : 'Production'}</span>
            <time class="hi-pub-date">{formatDate(pub.date)}</time>
          </div>
          <div class="hi-pub-center">
            <h3 class="hi-pub-title">{pub.title}</h3>
            <p class="hi-pub-excerpt">{pub.abstract?.slice(0, 120)}...</p>
          </div>
          <span class="hi-pub-arrow" aria-hidden="true">arrow</span>
        </a>
      ))}
    </div>
  </section>

</Page>

<style>
/* HERO */
.hi-hero {
  padding: clamp(64px,9vw,110px) 0 clamp(56px,8vw,96px);
  border-bottom: 1px solid var(--line);
}

/* Anthropic full-width bold paragraph */
.hi-headline-wrap {
  max-width: 860px;
  margin-bottom: 36px;
}
.hi-headline {
  font-size: clamp(1.45rem, 3.2vw, 2.5rem);
  line-height: 1.38;
  color: var(--text);
  margin: 0;
  letter-spacing: -0.02em;
  font-weight: 400;
}
.hi-headline strong {
  font-weight: 800;
}

.hi-actions { display: flex; gap: 12px; flex-wrap: wrap }
.hi-btn-primary {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 11px 24px; border-radius: 9999px;
  background: var(--text); color: var(--bg);
  font-size: .9rem; font-weight: 600;
  text-decoration: none; white-space: nowrap;
  transition: opacity .15s ease, transform .15s ease;
}
.hi-btn-primary:hover { opacity: .85; transform: translateY(-1px) }
.hi-btn-ghost {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 10px 22px; border-radius: 9999px;
  border: 1px solid var(--line-hover);
  color: var(--text-soft); font-size: .9rem; font-weight: 500;
  text-decoration: none; white-space: nowrap;
  transition: border-color .15s ease, color .15s ease;
}
.hi-btn-ghost:hover { border-color: var(--text); color: var(--text) }

/* BANNER */
.hi-banner { width: 100% }
.hi-banner-link {
  display: block; position: relative; overflow: hidden;
  text-decoration: none; height: clamp(280px,40vw,480px);
}
.hi-banner-bg {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, #050d1a 0%, #0b1f3a 18%, #163660 40%, #bf5c18 72%, #080808 100%);
}
.hi-banner-bg::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 80% 50% at 50% 68%, rgba(185,88,24,.45) 0%, transparent 65%);
  animation: banner-glow 8s ease-in-out infinite;
}
@keyframes banner-glow { 0%,100% { opacity: .7 } 50% { opacity: 1 } }
.hi-banner-inner {
  position: relative; z-index: 1; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center; gap: 14px; padding: 40px 24px;
}
.hi-banner-tag {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: .72rem; font-weight: 600; letter-spacing: .1em;
  text-transform: uppercase; color: rgba(255,255,255,.6);
}
.hi-banner-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.5) }
.hi-banner-title {
  font-size: clamp(3rem,10vw,8rem); font-weight: 700;
  letter-spacing: -0.04em; color: #fff; margin: 0;
  font-family: 'Playfair Display', Georgia, serif; line-height: 1;
}
.hi-banner-sub { font-size: clamp(.88rem,1.5vw,1.05rem); color: rgba(255,255,255,.65); margin: 0; max-width: 460px }
.hi-banner-cta {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 9px 24px; border-radius: 9999px;
  border: 1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.08);
  color: rgba(255,255,255,.85); font-size: .86rem; font-weight: 600;
  backdrop-filter: blur(8px); transition: background .2s ease;
}
.hi-banner-link:hover .hi-banner-cta { background: rgba(255,255,255,.18) }

/* LEARN MORE CARDS */
.hi-learn { padding: clamp(56px,8vw,96px) 0; border-bottom: 1px solid var(--line) }
.hi-learn-label {
  font-size: .78rem; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: var(--muted); margin: 0 0 24px;
}
.hi-learn-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px }
.hi-card { display: flex; flex-direction: column; text-decoration: none; transition: opacity .15s }
.hi-card:hover { opacity: .85 }
.hi-card-img { width: 100%; aspect-ratio: 4/3; border-radius: 10px; overflow: hidden; margin-bottom: 14px; position: relative }
.hi-card-img-inner { position: absolute; inset: 0 }
.hi-card-img--arch .hi-card-img-inner {
  background: linear-gradient(135deg,#0d1f40 0%,#1a3a6a 50%,#2a5c9a 100%);
}
.hi-card-img--arch .hi-card-img-inner::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 30% 30%, rgba(42,108,245,.5) 0%, transparent 60%);
}
.hi-card-img--align .hi-card-img-inner {
  background: linear-gradient(135deg,#1a0a2e 0%,#2d1460 50%,#4a2080 100%);
}
.hi-card-img--align .hi-card-img-inner::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 60% 40%, rgba(139,92,246,.5) 0%, transparent 55%);
}
.hi-card-img--w12 .hi-card-img-inner {
  background: linear-gradient(135deg,#0a1a0a 0%,#1a3a1a 50%,#2a5a2a 100%);
}
.hi-card-img--w12 .hi-card-img-inner::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(34,197,94,.4) 0%, transparent 55%);
}
.hi-card-img--safety .hi-card-img-inner {
  background: linear-gradient(135deg,#1a1a0a 0%,#3a3a10 50%,#5a5a18 100%);
}
.hi-card-img--safety .hi-card-img-inner::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 40% 60%, rgba(234,179,8,.35) 0%, transparent 55%);
}
.hi-card-cat { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px }
.hi-card-title { font-size: 1.05rem; font-weight: 700; color: var(--text); margin: 0 0 8px; letter-spacing: -.02em; line-height: 1.3 }
.hi-card-desc { font-size: .84rem; color: var(--text-soft); line-height: 1.6; margin: 0 }

/* PUBLICATIONS */
.hi-pubs { padding: clamp(56px,8vw,96px) 0 clamp(72px,10vw,120px) }
.hi-pubs-head {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 16px; margin-bottom: 0; padding-bottom: 16px; border-bottom: 1px solid var(--line);
}
.hi-pubs-title { font-size: clamp(1.4rem,2.5vw,2rem); font-weight: 700; letter-spacing: -.04em; color: var(--text); margin: 0 }
.hi-pubs-more { font-size: .88rem; font-weight: 600; color: var(--text-soft); text-decoration: none; white-space: nowrap; transition: color .15s }
.hi-pubs-more:hover { color: var(--text) }
.hi-pubs-list { display: flex; flex-direction: column }
.hi-pub-row {
  display: grid; grid-template-columns: 200px 1fr 24px;
  gap: 28px; align-items: start; padding: 24px 0;
  border-bottom: 1px solid var(--line); text-decoration: none;
}
.hi-pub-row:hover .hi-pub-title { color: #2a6cf5 }
.hi-pub-row:hover .hi-pub-arrow { color: var(--text) }
.hi-pub-left { display: flex; flex-direction: column; gap: 4px; padding-top: 2px }
.hi-pub-type { font-size: .74rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--text-soft) }
.hi-pub-date { font-size: .76rem; color: var(--muted) }
.hi-pub-title { font-size: 1rem; font-weight: 700; letter-spacing: -.015em; color: var(--text); margin: 0 0 5px; line-height: 1.35; transition: color .15s }
.hi-pub-excerpt { font-size: .82rem; color: var(--text-soft); line-height: 1.55; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden }
.hi-pub-arrow { font-size: .85rem; color: var(--muted); padding-top: 2px; transition: color .2s }

/* RESPONSIVE */
@media (max-width: 900px) {
  .hi-learn-grid { grid-template-columns: repeat(2,1fr) }
  .hi-pub-row { grid-template-columns: 1fr 24px; gap: 16px }
  .hi-pub-left { display: none }
}
@media (max-width: 600px) {
  .hi-learn-grid { grid-template-columns: 1fr 1fr }
  .hi-headline { font-size: 1.4rem }
  .hi-banner-link { height: 240px }
}
@media (max-width: 400px) {
  .hi-learn-grid { grid-template-columns: 1fr }
}
</style>
