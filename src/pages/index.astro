---
import Page from '../components/Page.astro'
import { SITE } from '../lib/site.js'
import { allPublications, formatDate, publicationStats } from '../lib/research.js'

const recent = allPublications.slice(0, 6)
const stats = publicationStats()
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  email: SITE.contactEmail,
  sameAs: SITE.githubUrl ? [SITE.githubUrl] : [],
}
---
<Page currentPath="/" title="Jhelum Labs — Research and Deployment" description="Jhelum Labs publishes open foundational AI research and model documentation for the W-1.1 program." jsonLd={jsonLd}>
  <div class="home">

    <!-- ══════════ HERO — Silk Aurora background ══════════ -->
    <section class="h-hero">
      <!-- WebGL aurora — renders on client -->
      <div id="aurora-mount" class="h-aurora-wrap" aria-hidden="true"></div>

      <div class="shell h-hero-inner">
        <!-- Logo + wordmark -->
        <div class="h-brand">
          <img src="/logo.png" alt="Jhelum Labs" class="h-logo" />
          <div class="h-brand-text">
            <span class="h-brand-name">Jhelum Labs</span>
            <span class="h-brand-sub">Research and Deployment</span>
          </div>
        </div>

        <!-- Mission -->
        <div class="h-mission">
          <h1 class="h-headline">Research</h1>
          <p class="h-mission-text">
            Jhelum Labs investigates the architecture, training and safety of
            open experimental language models — publishing every finding openly
            so AI development stays transparent and reproducible.
          </p>
          <div class="h-actions">
            <a class="h-btn-primary" href="/research">Explore research</a>
            <a class="h-btn-ghost" href="/playground">Try W-1.1 →</a>
          </div>
        </div>

        <!-- Split-flap stats -->
        <div id="flap-mount" class="h-flap-row"></div>

      </div>
    </section>

    <!-- ══════════ TEAMS ══════════ -->
    <section class="h-teams shell">
      <div class="h-teams-grid" id="teams-reveal">
        {[
          { name: 'Architecture', desc: 'Designing efficient decoder-only Transformers — RoPE, RMSNorm, SwiGLU, GQA — for open reproducible pretraining.' },
          { name: 'Training', desc: 'Documenting pretraining runs, loss curves, checkpointing and recovery across W-1.1 experiment phases.' },
          { name: 'Evaluation', desc: 'Measuring intrinsic quality (perplexity, accuracy) and downstream benchmarks including PIQA, ARC and HellaSwag.' },
          { name: 'Alignment', desc: 'Instruction-tuning, preference optimization and safety calibration for open experimental models.' },
        ].map((team) => (
          <div class="h-team-card">
            <h3 class="h-team-name">{team.name}</h3>
            <p class="h-team-desc">{team.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════ FEATURED ══════════ -->
    <section class="h-featured shell">
      <div class="h-section-head">
        <div>
          <p class="h-eyebrow">Latest publication</p>
          <h2 class="h-section-title">Most recent research</h2>
        </div>
        <a class="h-view-all" href="/research">View all research ↗</a>
      </div>
      {recent[0] && (
        <a class="h-featured-card" href={recent[0].articlePath}>
          <div class="h-featured-meta">
            <span class={`h-tag ${recent[0].type === 'Research Paper' ? 'h-tag--paper' : 'h-tag--doc'}`}>
              {recent[0].type === 'Research Paper' ? 'Research paper' : 'Production doc'}
            </span>
            <time class="h-featured-date">{formatDate(recent[0].date)}</time>
          </div>
          <h2 class="h-featured-title">{recent[0].title}</h2>
          <p class="h-featured-abstract">{recent[0].abstract}</p>
          <span class="h-featured-cta">Read paper →</span>
        </a>
      )}
    </section>

    <!-- ══════════ PUBLICATION LIST — scroll reveal ══════════ -->
    <section class="h-publications shell">
      <div class="h-section-head">
        <div>
          <p class="h-eyebrow">Publications</p>
          <h2 class="h-section-title">All research</h2>
        </div>
        <a class="h-view-all" href="/research">See all ↗</a>
      </div>
      <div class="h-pub-list" id="pub-reveal">
        {recent.slice(1).map((pub) => (
          <a class="h-pub-row" href={pub.articlePath}>
            <div class="h-pub-left">
              <span class={`h-tag ${pub.type === 'Research Paper' ? 'h-tag--paper' : 'h-tag--doc'}`}>
                {pub.type === 'Research Paper' ? 'Research' : 'Docs'}
              </span>
              <time class="h-pub-date">{formatDate(pub.date)}</time>
            </div>
            <div class="h-pub-center">
              <h3 class="h-pub-title">{pub.title}</h3>
              <p class="h-pub-abstract">{pub.abstract}</p>
            </div>
            <span class="h-pub-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="h-cta shell">
      <div class="h-cta-inner">
        <div>
          <h2 class="h-cta-title">Try W-1.1 locally</h2>
          <p class="h-cta-desc">
            Download the open weights and run the model on your own machine.
            Apache-2.0 · 493 MB · verified SHA-256.
          </p>
        </div>
        <div class="h-cta-actions">
          <a class="h-btn-primary" href="/playground">Get started →</a>
          <a class="h-btn-ghost" href={SITE.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
    </section>

  </div>
</Page>

<!-- ── Client islands ── -->
<script>
  import SilkAurora from '../components/SilkAurora.jsx'
  import SplitFlap  from '../components/SplitFlap.jsx'
  import { createElement } from 'react'
  import { createRoot } from 'react-dom/client'
  import '../components/SilkAurora.css'
  import '../components/SplitFlap.css'

  /* Silk Aurora */
  const auroraMount = document.getElementById('aurora-mount')
  if (auroraMount) {
    createRoot(auroraMount).render(
      createElement(SilkAurora, {
        baseColor:   [0.03, 0.03, 0.07],
        accentColor: [0.08, 0.38, 0.45],
        intensity: 0.9,
        grain: 0.7,
        speed: 0.8,
      })
    )
  }

  /* Split Flap stats */
  const flapMount = document.getElementById('flap-mount')
  if (flapMount) {
    const stats = [
      { label: 'Publications', value: '11' },
      { label: 'Papers',       value: '07' },
      { label: 'Prod docs',    value: '03' },
      { label: 'Models',       value: '02' },
    ]
    const row = document.createElement('div')
    row.className = 'h-flap-stats'
    stats.forEach(({ label, value }) => {
      const item = document.createElement('div')
      item.className = 'h-flap-item'
      const sfDiv = document.createElement('div')
      sfDiv.className = 'h-flap-sf'
      const lbl = document.createElement('span')
      lbl.className = 'h-flap-label'
      lbl.textContent = label
      item.appendChild(sfDiv)
      item.appendChild(lbl)
      row.appendChild(item)
      createRoot(sfDiv).render(
        createElement(SplitFlap, {
          text: value,
          accentColor: '#2a6cf5',
          staggerDelay: 50,
          flipSpeed: 38,
        })
      )
    })
    flapMount.appendChild(row)
  }

  /* Scroll reveal — publication rows */
  const pubReveal = document.getElementById('pub-reveal')
  if (pubReveal) {
    const rows = Array.from(pubReveal.children)
    rows.forEach((row, i) => {
      row.style.opacity = '0'
      row.style.transform = 'translateY(20px)'
      row.style.transition = `opacity 0.5s ease ${i * 75}ms, transform 0.5s ease ${i * 75}ms`
    })
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.opacity = '1'
          e.target.style.transform = 'translateY(0)'
          obs.unobserve(e.target)
        }
      })
    }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' })
    rows.forEach((r) => obs.observe(r))
  }

  /* Scroll reveal — team cards */
  const teamsReveal = document.getElementById('teams-reveal')
  if (teamsReveal) {
    const cards = Array.from(teamsReveal.children)
    cards.forEach((card, i) => {
      card.style.opacity = '0'
      card.style.transform = 'translateY(18px)'
      card.style.transition = `opacity 0.5s ease ${i * 90}ms, transform 0.5s ease ${i * 90}ms`
    })
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.opacity = '1'
          e.target.style.transform = 'translateY(0)'
          obs.unobserve(e.target)
        }
      })
    }, { threshold: 0.1 })
    cards.forEach((c) => obs.observe(c))
  }
</script>

<style>
.home { isolation: isolate }

/* ══ Hero ══ */
.h-hero {
  position: relative;
  overflow: hidden;
  padding: clamp(72px, 11vw, 130px) 0 clamp(60px, 9vw, 100px);
  border-bottom: 1px solid var(--line);
}

.h-aurora-wrap {
  position: absolute;
  inset: 0;
  z-index: 0;
  opacity: 0.55;
}

.h-hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 48px;
}

/* Brand */
.h-brand { display: flex; align-items: center; gap: 16px }
.h-logo { width: 64px; height: 64px; object-fit: contain; border-radius: 12px }
[data-theme='dark'] .h-logo { filter: invert(1) }
.h-brand-text { display: flex; flex-direction: column; gap: 2px }
.h-brand-name { font-size: 1.4rem; font-weight: 700; letter-spacing: -.03em; color: var(--text); line-height: 1 }
.h-brand-sub { font-size: .8rem; color: var(--muted); letter-spacing: .02em }

/* Mission */
.h-mission { max-width: 800px }
.h-headline {
  font-size: clamp(3.5rem, 9vw, 7.5rem);
  font-weight: 800;
  letter-spacing: -.05em;
  line-height: .96;
  color: var(--text);
  margin: 0 0 24px;
}
.h-mission-text {
  font-size: clamp(1rem, 1.8vw, 1.18rem);
  color: var(--text-soft);
  line-height: 1.65;
  max-width: 640px;
  margin: 0 0 32px;
}
.h-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap }
.h-btn-primary {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 28px; border-radius: 9999px;
  background: var(--text); color: var(--bg);
  font-size: .9rem; font-weight: 600;
  text-decoration: none;
  transition: opacity .15s ease, transform .15s ease;
}
.h-btn-primary:hover { opacity: .85; transform: translateY(-1px) }
.h-btn-ghost {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 12px 24px; border-radius: 9999px;
  border: 1px solid var(--line);
  color: var(--text-soft); font-size: .9rem; font-weight: 500;
  text-decoration: none;
  transition: border-color .15s ease, color .15s ease;
}
.h-btn-ghost:hover { border-color: var(--line-hover); color: var(--text) }

/* Split flap row */
.h-flap-row { display: flex }
.h-flap-stats { display: flex; align-items: flex-start; gap: 28px; flex-wrap: wrap }
.h-flap-item { display: flex; flex-direction: column; align-items: center; gap: 8px }
.h-flap-sf { display: flex }
.h-flap-label {
  font-size: .68rem; font-weight: 600; letter-spacing: .08em;
  text-transform: uppercase; color: var(--muted);
}

/* ══ Teams ══ */
.h-teams { padding: 72px 0; border-bottom: 1px solid var(--line) }
.h-teams-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1px;
  border: 1px solid var(--line);
  border-radius: 16px;
  overflow: hidden;
}
.h-team-card { padding: 28px 30px; background: var(--surface-card); transition: background .2s ease }
.h-team-card:hover { background: var(--surface-card-hover) }
.h-team-name { font-size: 1.05rem; font-weight: 700; color: var(--text); margin: 0 0 10px; letter-spacing: -.02em }
.h-team-desc { font-size: .88rem; color: var(--text-soft); line-height: 1.65; margin: 0 }

/* ══ Shared ══ */
.h-section-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 16px; margin-bottom: 28px;
}
.h-eyebrow {
  font-size: .73rem; font-weight: 600; letter-spacing: .09em;
  text-transform: uppercase; color: var(--muted); margin: 0 0 6px;
}
.h-section-title {
  font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  font-weight: 700; letter-spacing: -.035em; color: var(--text); margin: 0;
}
.h-view-all {
  font-size: .88rem; font-weight: 600; color: var(--text-soft);
  white-space: nowrap; text-decoration: none; transition: color .15s ease;
}
.h-view-all:hover { color: var(--text) }

/* Tags */
.h-tag {
  display: inline-flex; align-items: center;
  padding: 3px 10px; border-radius: 999px;
  font-size: .7rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
  border: 1px solid var(--line);
}
.h-tag--paper { color: var(--brand); border-color: rgba(42,108,245,.3); background: rgba(42,108,245,.08) }
.h-tag--doc { color: var(--text-soft); background: var(--surface-2) }

/* ══ Featured ══ */
.h-featured { padding: 72px 0; border-bottom: 1px solid var(--line) }
.h-featured-card {
  display: block; padding: 36px 40px;
  border: 1px solid var(--line); border-radius: 16px;
  background: var(--surface-card); text-decoration: none;
  transition: background .2s ease, border-color .2s ease, transform .2s ease;
}
.h-featured-card:hover { background: var(--surface-card-hover); border-color: var(--line-hover); transform: translateY(-2px) }
.h-featured-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 16px }
.h-featured-date { font-size: .8rem; color: var(--muted); font-family: var(--font-mono) }
.h-featured-title {
  font-size: clamp(1.6rem, 3.5vw, 2.6rem);
  font-weight: 700; letter-spacing: -.03em; color: var(--text);
  margin: 0 0 14px; line-height: 1.2;
}
.h-featured-abstract { font-size: 1rem; color: var(--text-soft); line-height: 1.65; margin: 0 0 24px; max-width: 780px }
.h-featured-cta { font-size: .9rem; font-weight: 600; color: var(--brand) }

/* ══ Publications ══ */
.h-publications { padding: 72px 0; border-bottom: 1px solid var(--line) }
.h-pub-list { display: flex; flex-direction: column }
.h-pub-row {
  display: grid; grid-template-columns: 190px 1fr 28px;
  gap: 24px; align-items: start;
  padding: 24px 0; border-bottom: 1px solid var(--line-subtle);
  text-decoration: none;
}
.h-pub-row:first-child { border-top: 1px solid var(--line-subtle) }
.h-pub-row:hover .h-pub-title { color: var(--brand) }
.h-pub-row:hover .h-pub-arrow { transform: translate(3px,-3px); color: var(--text) }
.h-pub-left { display: flex; flex-direction: column; gap: 6px; padding-top: 3px }
.h-pub-date { font-size: .78rem; color: var(--muted); font-family: var(--font-mono) }
.h-pub-title { font-size: 1.08rem; font-weight: 600; letter-spacing: -.02em; color: var(--text); margin: 0 0 6px; transition: color .15s ease }
.h-pub-abstract { font-size: .86rem; color: var(--text-soft); line-height: 1.55; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden }
.h-pub-arrow { color: var(--muted); font-size: 1rem; padding-top: 3px; transition: transform .2s ease, color .2s ease }

/* ══ CTA ══ */
.h-cta { padding: 80px 0 100px }
.h-cta-inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 40px; padding: 48px;
  border: 1px solid var(--line); border-radius: 16px;
  background: linear-gradient(135deg, var(--surface-card), color-mix(in srgb, var(--surface-2) 85%, var(--brand) 15%));
  flex-wrap: wrap;
}
.h-cta-title { font-size: clamp(1.8rem,3.5vw,2.6rem); font-weight: 700; letter-spacing: -.035em; color: var(--text); margin: 0 0 10px }
.h-cta-desc { font-size: 1rem; color: var(--text-soft); max-width: 540px; margin: 0; line-height: 1.6 }
.h-cta-actions { display: flex; gap: 12px; flex-shrink: 0; flex-wrap: wrap }

/* ══ Responsive ══ */
@media (max-width: 760px) {
  .h-pub-row { grid-template-columns: 1fr 24px; gap: 14px }
  .h-pub-left { display: none }
  .h-featured-card { padding: 24px }
  .h-cta-inner { padding: 28px }
  .h-cta-actions { width: 100% }
  .h-btn-primary, .h-btn-ghost { justify-content: center; flex: 1 }
  .h-aurora-wrap { opacity: 0.35 }
}
@media (max-width: 480px) {
  .h-pub-abstract { display: none }
  .h-teams-grid { grid-template-columns: 1fr }
  .h-headline { font-size: 3rem }
  .h-flap-stats { gap: 16px }
}
</style>
