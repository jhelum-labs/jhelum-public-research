---
import Page from '../components/Page.astro'
import { SITE } from '../lib/site.js'
import { allPublications, formatDate } from '../lib/research.js'

const recent = allPublications.slice(0, 5)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  email: SITE.contactEmail,
  sameAs: SITE.githubUrl ? [SITE.githubUrl] : [],
}
---
<Page currentPath="/" title="Jhelum Labs — Research and Deployment" description="Jhelum Labs publishes open foundational AI research and model documentation." jsonLd={jsonLd}>

  <!-- ══════════ HERO — Two-column Anthropic style ══════════ -->
  <section class="ah-hero">
    <div class="shell ah-hero-inner">
      <div class="ah-hero-left">
        <h1 class="ah-hero-headline">
          Open AI <span class="ah-underline">research</span> and<br/>
          <span class="ah-underline">model weights</span><br/>
          built in public
        </h1>
      </div>
      <div class="ah-hero-right">
        <p class="ah-hero-desc">
          Jhelum Labs is an independent AI research group. We train language
          models from scratch, document every experiment, and publish all
          weights openly — so the world can verify, reproduce and build on
          our work.
        </p>
        <a class="ah-btn-primary" href="/research">Explore research →</a>
      </div>
    </div>
  </section>

  <!-- ══════════ FULL-WIDTH BANNER ══════════ -->
  <section class="ah-banner">
    <a href="/playground" class="ah-banner-link">
      <div class="ah-banner-bg"></div>
      <div class="ah-banner-content">
        <h2 class="ah-banner-title">W-1.1</h2>
        <p class="ah-banner-sub">Our first open 123M-parameter language model, trained from scratch.</p>
        <span class="ah-banner-cta">Try W-1.1 →</span>
      </div>
    </a>
  </section>

  <!-- ══════════ RESEARCH TEAMS ══════════ -->
  <section class="ah-teams">
    <div class="shell">
      <div class="ah-teams-inner">
        <div class="ah-teams-left">
          <p class="ah-eyebrow">Research teams</p>
          <div class="ah-team-links">
            <a href="/research?type=Research+Paper">Architecture</a>
            <a href="/research?type=Research+Paper">Training</a>
            <a href="/research?type=Research+Paper">Evaluation</a>
            <a href="/research?type=Production+Document">Alignment</a>
          </div>
        </div>
        <div class="ah-teams-grid">
          {[
            { name: 'Architecture', desc: 'Designing efficient decoder-only Transformers using RoPE, RMSNorm, SwiGLU and grouped-query attention for open reproducible pretraining.' },
            { name: 'Training', desc: 'Documenting every pretraining run — loss curves, checkpointing, recovery — across all W-1.1 experiment phases on H100 and T4 GPUs.' },
            { name: 'Evaluation', desc: 'Measuring intrinsic quality with perplexity and token accuracy, plus downstream benchmarks including PIQA, ARC, BoolQ and HellaSwag.' },
            { name: 'Alignment', desc: 'Instruction-tuning on 300K Q&A pairs, preference optimization and safety calibration for experimental open models.' },
            { name: 'W-1.2', desc: 'Planning the next generation: 353M parameters, grouped-query attention, 50K BPE vocabulary, 4,096 context, 8B training tokens.' },
          ].map((t) => (
            <div class="ah-team-card">
              <h3>{t.name}</h3>
              <p>{t.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ RECENT PUBLICATIONS (Anthropic two-column) ══════════ -->
  <section class="ah-pubs">
    <div class="shell">
      <div class="ah-pubs-inner">

        <!-- Left: featured visual -->
        <div class="ah-pubs-left">
          <div class="ah-pubs-visual">
            <div class="ah-visual-card">
              <div class="ah-visual-bg"></div>
              <div class="ah-visual-text">
                <span class="ah-visual-eyebrow">{recent[0]?.type}</span>
                <h3>{recent[0]?.title}</h3>
                <p>{recent[0]?.abstract?.slice(0, 120)}…</p>
                <a href={recent[0]?.articlePath} class="ah-visual-link">Read →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: list -->
        <div class="ah-pubs-right">
          {recent.slice(1).map((pub) => (
            <a class="ah-pub-item" href={pub.articlePath}>
              <div class="ah-pub-meta">
                <span class="ah-pub-type">{pub.type === 'Research Paper' ? pub.type : 'Production'}</span>
                <time>{formatDate(pub.date)}</time>
              </div>
              <h3 class="ah-pub-title">{pub.title}</h3>
              <p class="ah-pub-excerpt">{pub.abstract?.slice(0, 100)}…</p>
            </a>
          ))}
          <a class="ah-see-all" href="/research">See all publications →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ W-1.1 MODEL CARD ══════════ -->
  <section class="ah-model">
    <div class="shell ah-model-inner">
      <div>
        <p class="ah-eyebrow">W-1.1 · 125M</p>
        <h2 class="ah-model-title">Open weights. Run it yourself.</h2>
        <p class="ah-model-desc">
          Download the safetensors file, install dependencies, and run
          inference locally in under 5 minutes. No API key. No cloud.
          Full source code on GitHub.
        </p>
        <div class="ah-model-actions">
          <a class="ah-btn-primary" href="/playground">Get started →</a>
          <a class="ah-btn-outline" href={SITE.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>
      <div class="ah-model-specs">
        {[
          ['Parameters', '123.7M'],
          ['Vocabulary', '32K BPE'],
          ['Context', '2,048 tokens'],
          ['Architecture', 'Decoder-only'],
          ['Training', 'H100 80GB'],
          ['License', 'Apache-2.0'],
        ].map(([label, value]) => (
          <div class="ah-spec-row">
            <span class="ah-spec-label">{label}</span>
            <span class="ah-spec-value">{value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

</Page>

<style>
/* ══ Hero ══ */
.ah-hero {
  padding: clamp(80px, 12vw, 140px) 0 clamp(64px, 10vw, 110px);
  border-bottom: 1px solid var(--line);
}
.ah-hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(40px, 6vw, 80px);
  align-items: end;
}
.ah-hero-headline {
  font-size: clamp(2.6rem, 5.5vw, 4.8rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.05;
  color: var(--text);
  margin: 0;
}
.ah-underline {
  text-decoration: underline;
  text-decoration-thickness: 3px;
  text-underline-offset: 4px;
  text-decoration-color: var(--text);
}
.ah-hero-right {
  display: flex;
  flex-direction: column;
  gap: 28px;
  padding-bottom: 8px;
}
.ah-hero-desc {
  font-size: clamp(1rem, 1.5vw, 1.12rem);
  color: var(--text-soft);
  line-height: 1.7;
  margin: 0;
}

/* Buttons */
.ah-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 11px 24px;
  border-radius: 9999px;
  background: var(--text);
  color: var(--bg);
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  width: fit-content;
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.ah-btn-primary:hover { opacity: 0.85; transform: translateY(-1px) }
.ah-btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 22px;
  border-radius: 9999px;
  border: 1px solid var(--line-hover);
  color: var(--text-soft);
  font-size: 0.9rem;
  font-weight: 500;
  text-decoration: none;
  width: fit-content;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.ah-btn-outline:hover { border-color: var(--text); color: var(--text) }

/* ══ Full-width banner ══ */
.ah-banner { width: 100% }
.ah-banner-link { display: block; text-decoration: none; position: relative; overflow: hidden; height: clamp(320px, 45vw, 520px) }
.ah-banner-bg {
  position: absolute; inset: 0;
  background: linear-gradient(
    180deg,
    #0a1628 0%,
    #0d2137 25%,
    #1a3a5c 50%,
    #c4621a 78%,
    #0a0a0a 100%
  );
}
/* animated aurora glow */
.ah-banner-bg::after {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse 80% 50% at 50% 60%, rgba(180,80,20,.35) 0%, transparent 70%);
  animation: banner-pulse 6s ease-in-out infinite;
}
@keyframes banner-pulse {
  0%,100% { opacity: .7; transform: scaleX(1) }
  50% { opacity: 1; transform: scaleX(1.05) }
}
.ah-banner-content {
  position: relative; z-index: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  height: 100%; text-align: center; padding: 40px 24px;
}
.ah-banner-title {
  font-size: clamp(3rem, 9vw, 7rem);
  font-weight: 700;
  letter-spacing: -0.04em;
  color: #fff;
  margin: 0 0 12px;
  font-family: 'Playfair Display', Georgia, serif;
}
.ah-banner-sub { font-size: clamp(.95rem,1.8vw,1.2rem); color: rgba(255,255,255,.75); margin: 0 0 28px; max-width: 480px }
.ah-banner-cta {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 11px 28px; border-radius: 9999px;
  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.3);
  color: #fff; font-size: .9rem; font-weight: 600;
  backdrop-filter: blur(8px); transition: background .2s ease;
}
.ah-banner-link:hover .ah-banner-cta { background: rgba(255,255,255,.2) }

/* ══ Eyebrow ══ */
.ah-eyebrow {
  font-size: .72rem; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: var(--muted); margin: 0 0 16px;
}

/* ══ Teams ══ */
.ah-teams {
  padding: clamp(64px,9vw,100px) 0;
  border-bottom: 1px solid var(--line);
}
.ah-teams-inner { display: grid; grid-template-columns: 200px 1fr; gap: 64px }
.ah-team-links {
  display: flex; flex-direction: column; gap: 8px;
}
.ah-team-links a {
  font-size: .88rem; font-weight: 500;
  color: var(--text-soft); text-decoration: underline;
  text-underline-offset: 3px; transition: color .15s ease;
}
.ah-team-links a:hover { color: var(--text) }
.ah-teams-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 32px;
  border-top: 1px solid var(--line);
  padding-top: 32px;
}
.ah-team-card h3 {
  font-size: 1rem; font-weight: 700; color: var(--text);
  margin: 0 0 10px; letter-spacing: -.015em;
}
.ah-team-card p { font-size: .85rem; color: var(--text-soft); line-height: 1.65; margin: 0 }

/* ══ Publications ══ */
.ah-pubs {
  padding: clamp(64px,9vw,100px) 0;
  border-bottom: 1px solid var(--line);
}
.ah-pubs-inner { display: grid; grid-template-columns: 5fr 4fr; gap: 64px; align-items: start }

/* Visual card */
.ah-pubs-visual { position: sticky; top: 90px }
.ah-visual-card {
  position: relative; overflow: hidden;
  border-radius: 16px; height: clamp(280px,38vw,420px);
}
.ah-visual-bg {
  position: absolute; inset: 0;
  background: linear-gradient(135deg,#0d1f3c 0%,#1a3a5c 40%,#2a5c8a 70%,#0a0a0a 100%);
}
.ah-visual-bg::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 70% 60% at 30% 40%, rgba(42,108,245,.3) 0%, transparent 65%);
}
.ah-visual-text {
  position: relative; z-index: 1; padding: 32px 28px;
  display: flex; flex-direction: column; gap: 12px; height: 100%;
}
.ah-visual-eyebrow {
  font-size: .68rem; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: rgba(255,255,255,.6);
}
.ah-visual-text h3 {
  font-size: clamp(1.2rem,2.5vw,1.8rem);
  font-weight: 700; color: #fff; margin: 0; line-height: 1.25; letter-spacing: -.025em;
}
.ah-visual-text p { font-size: .88rem; color: rgba(255,255,255,.65); line-height: 1.6; margin: 0 }
.ah-visual-link {
  margin-top: auto; font-size: .88rem; font-weight: 600;
  color: rgba(255,255,255,.8); align-self: flex-start;
  transition: color .15s ease;
}
.ah-visual-link:hover { color: #fff }

/* Article list */
.ah-pubs-right { display: flex; flex-direction: column; gap: 0 }
.ah-pub-item {
  display: block; padding: 24px 0;
  border-bottom: 1px solid var(--line);
  text-decoration: none; transition: opacity .15s ease;
}
.ah-pub-item:first-child { border-top: 1px solid var(--line) }
.ah-pub-item:hover { opacity: 1 }
.ah-pub-item:hover .ah-pub-title { color: var(--brand) }
.ah-pub-meta {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 6px; font-size: .78rem; color: var(--muted);
}
.ah-pub-type { font-weight: 600; color: var(--text-soft) }
.ah-pub-title {
  font-size: 1rem; font-weight: 700; letter-spacing: -.015em;
  color: var(--text); margin: 0 0 6px; line-height: 1.35;
  transition: color .15s ease;
}
.ah-pub-excerpt { font-size: .83rem; color: var(--text-soft); line-height: 1.55; margin: 0 }
.ah-see-all {
  display: inline-flex; align-items: center; gap: 4px;
  margin-top: 20px; font-size: .88rem; font-weight: 600;
  color: var(--text-soft); transition: color .15s ease;
}
.ah-see-all:hover { color: var(--text) }

/* ══ Model card ══ */
.ah-model {
  padding: clamp(64px,9vw,100px) 0;
  border-bottom: 1px solid var(--line);
}
.ah-model-inner {
  display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;
}
.ah-model-title {
  font-size: clamp(2rem,4vw,3.2rem);
  font-weight: 800; letter-spacing: -.04em; color: var(--text);
  margin: 0 0 16px; line-height: 1.1;
}
.ah-model-desc { font-size: 1rem; color: var(--text-soft); line-height: 1.7; margin: 0 0 28px }
.ah-model-actions { display: flex; gap: 12px; flex-wrap: wrap }
.ah-model-specs {
  border: 1px solid var(--line);
  border-radius: 14px; overflow: hidden;
  background: var(--surface-card);
}
.ah-spec-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 13px 20px; border-bottom: 1px solid var(--line);
  font-size: .88rem;
}
.ah-spec-row:last-child { border-bottom: none }
.ah-spec-label { color: var(--muted) }
.ah-spec-value { font-weight: 600; color: var(--text); font-family: var(--font-mono); font-size: .82rem }

/* ══ Responsive ══ */
@media (max-width: 900px) {
  .ah-hero-inner { grid-template-columns: 1fr; gap: 28px }
  .ah-teams-inner { grid-template-columns: 1fr; gap: 28px }
  .ah-pubs-inner { grid-template-columns: 1fr; gap: 40px }
  .ah-pubs-visual { position: static }
  .ah-model-inner { grid-template-columns: 1fr; gap: 36px }
}
@media (max-width: 600px) {
  .ah-hero-headline { font-size: 2.4rem }
  .ah-banner-link { height: 260px }
  .ah-teams-grid { grid-template-columns: 1fr }
}
</style>
