---
import Page from '../components/Page.astro'
import { SITE } from '../lib/site.js'
import { allPublications, publicationStats } from '../lib/research.js'

const stats = publicationStats()
const featured = allPublications.slice(0, 3).map((publication, index) => ({ ...publication, cover: ['/research-covers/architecture.svg', '/research-covers/instruct.svg', '/research-covers/final-report.svg'][index] }))
const jsonLd = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url, logo: `${SITE.url}/jhelum-labs-mark.svg`, email: SITE.contactEmail, sameAs: SITE.githubUrl ? [SITE.githubUrl] : [] }
---
<Page currentPath="/" title="Jhelum Labs — Research and Deployment" description="Jhelum Labs publishes research and deployment documentation for W-1.1." jsonLd={jsonLd}>
  <div class="home-page">
    <section class="hero">
      <div class="hero-content shell">
        <h1 class="sr-only">Jhelum Labs</h1>
        <svg class="hero-wordmark" viewBox="0 160 1536 660" role="img" aria-label="Jhelum Labs, Research and Deployment">
          <g fill="#2a6cf5">
            <polygon points="152,310 306,310 335,344 176,344 49,611 82,611 196,372 358,372 394,413 228,413 124,628 0,628"/>
            <polygon points="396,185 627,472 553,598 497,606 576,473 388,240 370,266 537,477 458,611 402,620 482,485 326,289"/>
            <polygon points="203,513 295,651 570,614 633,720 236,780 146,640 168,592 258,729 589,683 572,655 275,697 183,559"/>
          </g>
          <path d="M322 443H362V538C362 575 340 592 308 592C295 592 290 590 290 590L272 560H322Z" fill="var(--mark-j)"/>
          <g fill="var(--text)" font-family="Poppins, 'Segoe UI', Arial, sans-serif" font-weight="700">
            <text x="648" y="525" font-size="140" textLength="518" lengthAdjust="spacingAndGlyphs">Jhelum</text>
            <polygon points="1189,415 1210,415 1253,527 1232,527"/>
            <text x="1250" y="525" font-size="140" textLength="246" lengthAdjust="spacingAndGlyphs">abs</text>
            <text x="768" y="592" font-size="48" font-weight="500" textLength="586" lengthAdjust="spacingAndGlyphs">Research and Deployment</text>
          </g>
        </svg>
        <div class="hero-actions">
          <a class="button" href="/research">Explore research</a>
        </div>
      </div>
    </section>

    <section class="home-research shell">
      <div class="section-head">
        <div><p class="section-eyebrow">Latest publications</p><h2>Research</h2></div>
        <a class="text-link" href="/research">View all research <span aria-hidden="true">↗</span></a>
      </div>
      <div class="card-grid">
        {featured.map((publication) => <a class="card" href={publication.articlePath}>
          <div class="card-image"><img src={publication.cover} alt={`Abstract cover for ${publication.title}`} width="1200" height="800" loading="lazy" /></div>
          <div class="card-body"><span class="type">{publication.type}</span><h3>{publication.title}</h3><p>{publication.abstract}</p></div>
        </a>)}
      </div>
    </section>

    <section class="home-stats shell" aria-label="Publication statistics">
      <div><strong>{stats.total}</strong><span>Publications</span></div>
      <div><strong>{stats.papers}</strong><span>Research papers</span></div>
      <div><strong>{stats.documents}</strong><span>Production docs</span></div>
    </section>

    <section class="w11 home-w11" id="w-1-1"><div class="shell w11-inner"><div><p class="section-eyebrow">W-1.1</p><h2>The published model program</h2><p>Read the research record for the W-1.1 model program.</p></div><a class="text-link" href={SITE.cta.url}>{SITE.cta.label} <span aria-hidden="true">↗</span></a></div></section>
  </div>
</Page>
