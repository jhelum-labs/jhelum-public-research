---
import Page from '../components/Page.astro'
import ScrollVelocity from '../components/ScrollVelocity.astro'
import { SITE } from '../lib/site.js'
import { allPublications, formatDate, getPublication } from '../lib/research.js'

// Marquee marks — official assets pulled from each company's own site into
// public/logos/. Sarvam's glyph is white in the source file, so the light
// theme shows it inverted to black.
const stackLogos = [
  { name: 'Sarvam AI', imgLight: '/logos/sarvam.svg',      imgDark: '/logos/sarvam-white.svg' },
  { name: 'Krutrim',   imgLight: '/logos/krutrim.ico',     imgDark: '/logos/krutrim.ico' },
  { name: 'Yellow.ai', imgLight: '/logos/yellow.png',      imgDark: '/logos/yellow.png' },
  { name: 'Uniphore',  imgLight: '/logos/uniphore.webp',   imgDark: '/logos/uniphore.webp' },
  { name: 'Haptik',    imgLight: '/logos/haptik.png',      imgDark: '/logos/haptik.png' },
  { name: 'Locus',     imgLight: '/logos/locus.ico',       imgDark: '/logos/locus.ico' },
  { name: 'Upheld AI', imgLight: '/logos/upheld-192.png',  imgDark: '/logos/upheld-192.png' },
  { name: 'Lagnever',  imgLight: '/logos/lagnever.png',     imgDark: '/logos/lagnever.png' },
]

const recent = allPublications.slice(0, 5)

// "Learn more" — Case Study Flip Stack: editorial cards that fold upward on
// scroll to reveal the next story. Titles/dates come from the publication
// record; each item carries its own card colour pair like the reference.
const railItems = [
  { slug: 'w-1.1-final-architecture', cover: '/covers/cover-architecture.png', cat: 'Architecture', title: 'W-1.1 Architecture', bg: '#2a6cf5', fg: '#f3f6ff' },
  { slug: 'w-1.1-project-instruct', cover: '/covers/cover-alignment.png', cat: 'Alignment', title: 'Project Instruct', bg: '#c2410c', fg: '#fff7ed' },
  { slug: 'w-1.2-architecture', cover: '/covers/cover-roadmap.png', cat: 'W-1.2 Roadmap', title: 'Next generation', bg: '#0e7490', fg: '#ecfeff' },
  { slug: 'w-1.1-final', cover: '/covers/cover-safety.png', cat: 'Safety', title: 'Model safety', bg: '#be185d', fg: '#fff1f7' },
  { slug: 'vitasta-architecture', cover: '/research-covers/architecture.svg', cat: 'Research paper', title: 'Vitasta: A Recurrent-Core Hybrid Architecture', bg: '#6d28d9', fg: '#f5f3ff' },
  { slug: 'verified-reasoning', cover: '/research-covers/instruct.svg', cat: 'Research paper', title: 'Verified Steps, Not Faster Guesses', bg: '#15803d', fg: '#f0fdf4' },
  { slug: 'w-1.1-project-spectrum', cover: '/research-covers/final-report.svg', cat: 'Research', title: 'Project Spectrum', bg: '#a16207', fg: '#fefce8' },
]

const stackItems = railItems.map((item) => {
  const pub = getPublication(item.slug)
  return {
    ...item,
    href: `/research/${item.slug}`,
    desc: pub?.abstract?.slice(0, 220) ?? '',
  }
})
const flipCardCount = Math.max(stackItems.length, 1)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: SITE.logoUrl,
  email: SITE.contactEmail,
  sameAs: SITE.githubUrl ? [SITE.githubUrl] : [],
}
---
<Page currentPath="/" title="Jhelum Labs | Research and Development" description="Jhelum Labs is an independent AI research organization building advanced language models." jsonLd={jsonLd}>

  <!-- HERO — Anthropic-style editorial paragraph -->
  <section class="hi-hero" data-home-hero>
    <div class="shell">

      <!-- Anthropic-style full-width bold paragraph headline -->
      <div class="hi-headline-wrap hero-copy-animate">
        <!-- Scroll ornament above the headline, Sarvam-style -->
        <div class="hi-ornament" aria-hidden="true">
          <svg viewBox="0 0 260 40" xmlns="http://www.w3.org/2000/svg" fill="none">
            <!-- centre hairline -->
            <line x1="6" y1="33" x2="254" y2="33" stroke="#2a6cf5" stroke-width="1.4" stroke-opacity=".32"/>
            <!-- centre diamond -->
            <rect x="126.6" y="29.6" width="7" height="7" transform="rotate(45 130 33)" fill="#2a6cf5" fill-opacity=".55"/>
            <!-- right curl + leaves -->
            <g stroke="#2a6cf5" stroke-width="2.4" stroke-linecap="round" opacity=".72">
              <path d="M134 29 C141 15 152 9 158 14 C163 18.5 159 26 151.5 24.5 C146 23.4 147 16.5 153 17"/>
              <path d="M166 25 C174 18 182 18 188 23 C180 26.5 172 27 166 25"/>
            </g>
            <!-- left curl + leaves (mirror) -->
            <g stroke="#2a6cf5" stroke-width="2.4" stroke-linecap="round" opacity=".72" transform="scale(-1,1) translate(-260,0)">
              <path d="M134 29 C141 15 152 9 158 14 C163 18.5 159 26 151.5 24.5 C146 23.4 147 16.5 153 17"/>
              <path d="M166 25 C174 18 182 18 188 23 C180 26.5 172 27 166 25"/>
            </g>
          </svg>
        </div>
        <p class="hi-headline">
          <strong>Building advanced AI. Advancing research. Prioritizing safety.</strong>
          {' '}Jhelum Labs is an independent AI research organization building advanced
          language models and reliable, production-ready systems.
        </p>
      </div>

      <!-- Log in / Sign up, centred in the hero like the reference pages. The
           auth script toggles this row off once a visitor is signed in. -->
      <div class="hi-hero-auth hero-copy-animate" data-auth-guest style="animation-delay: 0.24s;">
        <a class="hi-auth-login" href="/login">Log in</a>
        <a class="btn-pill-signup" href="/signup">Sign up</a>
      </div>

    </div>
  </section>

  <ScrollVelocity mode="logos" logos={stackLogos} />

  <!-- W-1.1 BANNER -->
  <section class="hi-banner" data-scroll-reveal data-band="#e8f0fb">
    <div class="hi-banner-bg"></div>
    <div class="hi-banner-inner shell">
      <div class="hi-banner-tag">
        <span class="hi-banner-dot"></span>
        W-1.1 · Open Weights
      </div>
      <h2 class="hi-banner-title">W-1.1</h2>
      <p class="hi-banner-sub">Our first 123M-parameter language model, trained from scratch.</p>
      <a class="hi-banner-cta" href="/w-1.1">Read more →</a>
    </div>
  </section>

  <!-- LEARN MORE — case-study flip stack: cards fold upward on scroll.
       data-band turns the page sky blue for this whole portion in light
       mode, like the reflection.ai colour-blocked sections. -->
  <section aria-label="Case studies" data-band="#b8def7" data-band-name="sky">
    <div class="flip-hero">
      <p class="flip-label">Case studies</p>
      <h2 class="flip-heading">Research you can <em>build on</em>.</h2>
    </div>

    <div class="flip-track" data-flip-track style={`height:${(flipCardCount + 1) * 100}vh`}>
      <div class="flip-stage-outer">
          <div class="flip-deck" data-flip-deck>
            {[...stackItems].reverse().map((item, revIdx) => {
              const i = stackItems.length - revIdx - 1;
              return (
                <a
                  class="flip-card"
                  data-flip-card
                  data-flip-index={i}
                  href={item.href}
                  style={`z-index:${stackItems.length - i};`}
                >
                  <div
                    class="flip-panel"
                    style={`background-color:${item.bg};color:${item.fg};`}
                  >
                    <div class="flip-panel-copy">
                      <div class="flip-main-num">
                        <span class="flip-num">{String(i + 1).padStart(2, '0')}</span>
                      </div>
                      <div class="flip-main">
                        <p class="flip-eyebrow">{item.cat}</p>
                        <h3 class="flip-title">{item.title}</h3>
                        {item.desc && <p class="flip-desc">{item.desc}</p>}
                        <span class="flip-cta">Read the story →</span>
                      </div>
                    </div>
                    <div class="flip-panel-img">
                      <img
                        src={item.cover}
                        alt={`${item.title} cover artwork`}
                        width="800"
                        height="800"
                        loading={i < 2 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
      </div>
    </div>
  </section>

  <!-- WHAT WE DO / EXPLORE — its own dark-green zone in light mode
       (reflection style), off the sky-blue card band. -->
  <section class="flip-end-zone" aria-label="What we do" data-band="#1c5b40" data-band-name="forest">
    <div class="flip-end">
      <!-- What we do — Perplexity-style mission lines that surface as you scroll -->
      <div class="flip-what">
        <p class="flip-label">What we do</p>
        <div class="flip-what-stack">
          <p class="flip-what-line" data-band="#1c5b40" data-band-name="forest">Make frontier intelligence and research open source</p>
          <p class="flip-what-line" data-band="#1c5b40" data-band-name="forest">Provide privacy and safety to users from models</p>
          <p class="flip-what-line" data-band="#1c5b40" data-band-name="forest">Make compute cost very low</p>
        </div>
      </div>
      <a class="flip-end-label" href="/research">Explore the library</a>
    </div>
  </section>

  <!-- SCROLL SPLIT CARD — one wide image that separates into three panels and
       flips to the mission statements (adapted from componentry.dev's
       Scroll Split Card, rebuilt in plain HTML/CSS/JS). -->
  <section class="split" aria-label="Our mission">
    <div class="split-track" data-split-track style="height:500vh">
      <div class="split-stage">
        <div class="split-row" data-split-row>
          {[0, 1, 2].map((i) => {
            const backs = [
              { title: 'Open source frontier intelligence', desc: 'Make frontier intelligence and research open source.', bg: '#2a6cf5', fg: '#f3f6ff' },
              { title: 'Private by default', desc: 'Provide privacy and safety to users from models.', bg: '#0e7490', fg: '#ecfeff' },
              { title: 'Compute for everyone', desc: 'Make compute cost very low.', bg: '#15803d', fg: '#f0fdf4' },
            ];
            const b = backs[i];
            return (
              <div class="split-panel" data-split-panel data-split-index={i}>
                <div class="split-face split-front">
                  <img
                    src="/research-covers/our-mission.svg"
                    alt="Our Mission signboard artwork split across three panels"
                    width="1500"
                    height="900"
                    loading="eager"
                    decoding="async"
                  />
                </div>
                <div class="split-face split-back" style={`background-color:${b.bg};color:${b.fg};`}>
                  <h3 class="split-back-title">{b.title}</h3>
                  <p class="split-back-desc">{b.desc}</p>
                </div>
              </div>
            );
          })}
        </div>
        <p class="split-endline" data-split-endline>That's the mission.</p>
      </div>
    </div>
  </section>

  <noscript>
    <style>
      /* No-JS: the split scene becomes a plain static row of mission cards. */
      .split-track { height: auto !important }
      .split-stage {
        position: static; height: auto; min-height: 0;
        flex-direction: column; padding: 16vh 24px;
      }
      .split-row { transform: none }
      .split-front { display: none }
      .split-back { transform: none; z-index: 2 }
      .split-endline { opacity: 1; position: static; margin-top: 28px }
    </style>
  </noscript>

  <!-- LATEST RESEARCH -->
  <section class="hi-pubs shell" data-scroll-reveal data-band="#f6f8fb">
    <div class="hi-pubs-head">
      <h2 class="hi-pubs-title">Latest research</h2>
      <a href="/research" class="hi-pubs-more">View all →</a>
    </div>
    <div class="hi-pubs-list">
      {recent.map((pub) => (
        <a class="hi-pub-row" href={pub.articlePath}>
          <div class="hi-pub-left">
            <span class="hi-pub-type">{pub.type === 'Research Paper' ? 'Research' : 'Production'}</span>
            <time class="hi-pub-date">{formatDate(pub.date)}</time>
          </div>
          <div class="hi-pub-center">
            <h3 class="hi-pub-title">{pub.title}</h3>
            <p class="hi-pub-excerpt">{pub.abstract?.slice(0, 120)}...</p>
          </div>
          <span class="hi-pub-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <script>
    // Scroll-driven page colour (light mode only, homepage only): as each
    // banded section reaches the middle of the viewport, the page background
    // eases to that section's wash — like reflection.ai / sarvam.ai. The wash
    // is painted on <main> (the topmost opaque wrapper that hides a fixed
    // canvas behind content) so it is actually visible.
    const bands = Array.from(document.querySelectorAll('[data-band]'));
    if (bands.length) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const washTarget = document.querySelector('main') || document.body;
      if (reducedMotion) washTarget.style.transition = 'none';
      else washTarget.style.transition = 'background-color .55s ease, color .2s ease';

      const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';

      let ticking = false;
      const applyBand = () => {
        ticking = false;
        if (isDark()) {
          // dark theme has its own palette — drop the inline override
          washTarget.style.removeProperty('background-color');
          document.body.removeAttribute('data-band-token');
          return;
        }
        const centre = window.innerHeight * 0.5;
        let color = ''; // default (no wash) above the first band
        let token = '';
        for (const b of bands) {
          const r = b.getBoundingClientRect();
          if (r.top <= centre) {
            color = b.getAttribute('data-band');
            token = b.getAttribute('data-band-name') || '';
          }
        }
        washTarget.style.setProperty('background-color', color || '');
        // token lets CSS adapt text colours to each wash (navy heading on the
        // sky band, pale ink on the forest band)
        if (token) document.body.setAttribute('data-band-token', token);
        else document.body.removeAttribute('data-band-token');
      };
      // Direct (no rAF): the band math is trivial and rAF-starved windows
      // could otherwise stick with a stale page colour.
      const onScroll = () => { if (!ticking) { ticking = true; applyBand(); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      // keep colours right when the theme toggles light/dark
      new MutationObserver(onScroll).observe(
        document.documentElement, { attributes: true, attributeFilter: ['data-theme'] }
      );
      applyBand();
    }

    // Case-study flip stack — cards fold upward on scroll. Same maths as the
    // framer-motion original, driven by one spring-smoothed progress value:
    // each card folds (translateY -118% + rotateX 22deg) across its own slice
    // of the track, while the next rises from a small resting offset/scale.
    const flipTrack = document.querySelector('[data-flip-track]');
    const reducedMotionFlip = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (flipTrack && !reducedMotionFlip) {
      const flipCards = Array.from(flipTrack.querySelectorAll('[data-flip-card]'));
      const n = flipCards.length;
      if (n) {
        const clamp01 = (v) => Math.max(0, Math.min(1, v));
        const segment = 1 / n;
        const stackedGap = Math.min(24, 72 / Math.max(n - 1, 1));

        let target = 0;
        let current = 0;
        let running = false;
        let rafId = 0;
        let lastT = 0;
        let lastFrameAt = 0;
        let settled = false;

        const computeTarget = () => {
          const rect = flipTrack.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          target = clamp01(-rect.top / Math.max(total, 1));
        };

        const frame = (now) => {
          computeTarget();
          const dt = Math.min(50, (lastT ? now - lastT : 16)) / 1000;
          lastT = now;
          lastFrameAt = now;
          current += (target - current) * Math.min(1, dt * 9); // spring-ish easing
          if (Math.abs(target - current) < 0.0004) current = target;
          applyFlip(current);
          if (running) {
            rafId = requestAnimationFrame(frame);
            if (current === target) settled = true;
          }
        };

        const applyFlip = (p) => {
          for (const card of flipCards) {
            const i = parseInt(card.dataset.flipIndex, 10);
            const panel = card.firstElementChild;
            if (!panel) continue;
            // Exit: fold this card up onto the stack behind the stage top.
            const exitT = clamp01((p - i * segment) / segment);
            const yPct = exitT * -118;
            const stackOff = exitT * i * stackedGap;
            const rot = exitT * 22;
            // Entry: the coming card rises from its resting offset/scale.
            let entryT = 0;
            if (i > 0) {
              const entryStart = i * segment - segment;
              const entryEnd = Math.min(i * segment, entryStart + segment * 0.7);
              entryT = clamp01((p - entryStart) / Math.max(entryEnd - entryStart, 0.0001));
            }
            const restY = Math.min(i * 12, 34);
            const restScale = 1 - Math.min(i * 0.012, 0.035);
            const entryY = i === 0 ? 0 : restY * (1 - entryT);
            const entryScale = i === 0 ? 1 : restScale + entryT * (1 - restScale);
            card.style.transform = `translate3d(0, calc(${yPct.toFixed(3)}% + ${stackOff.toFixed(2)}px), 0) rotateX(${rot.toFixed(3)}deg)`;
            panel.style.transform = `translate3d(0, ${entryY.toFixed(2)}px, 0) scale(${entryScale.toFixed(4)})`;
          }
        };

        const startLoop = () => {
          if (running || document.hidden) return;
          running = true;
          settled = false;
          lastT = 0;
          rafId = requestAnimationFrame(frame);
        };
        const stopLoop = () => {
          running = false;
          cancelAnimationFrame(rafId);
        };

        // Only animate while the track (± a viewport) is on screen. The IO
        // handles entering/leaving; a scroll listener guarantees the loop is
        // always running while the section is in play (IO change events can
        // be missed after tab switches).
        new IntersectionObserver((entries) => {
          entries.forEach((e) => { e.isIntersecting ? startLoop() : stopLoop(); });
        }, { rootMargin: '120px 0px 120px 0px' }).observe(flipTrack);
        let flipTick = false;
        const ensureFlip = () => {
          const r = flipTrack.getBoundingClientRect();
          if (r.bottom > -240 && r.top < window.innerHeight + 240) {
            startLoop();
            // rAF can be starved (hidden windows): if the loop hasn't ticked
            // recently, paint the target state synchronously so scroll never
            // stalls on it
            if (performance.now() - lastFrameAt > 300) {
              computeTarget();
              current = target;
              applyFlip(target);
            }
          } else stopLoop();
        };
        window.addEventListener('scroll', ensureFlip, { passive: true });
        ensureFlip();
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stopLoop();
        });
      }
    }

    // "What we do" ghost lines — fallback reveal for browsers without
    // scroll-driven animations: transparent until a line nears the middle
    // of the viewport, full ink at the centre, back to ghost past it.
    const whatLines = Array.from(document.querySelectorAll('.flip-what-line'));
    if (whatLines.length) {
      const supportsViewTimeline = CSS.supports('animation-timeline', 'view()');
      if (!supportsViewTimeline) {
        // hide them now that JS is live (before this they stay visible)
        document.documentElement.setAttribute('data-what-ghost', '');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const GHOST = 0.15;
          const updateWhat = () => {
            const centre = window.innerHeight * 0.5;
            const ramp = window.innerHeight * 0.55; // px of approach to full ink
            for (const line of whatLines) {
              const r = line.getBoundingClientRect();
              const d = Math.abs(r.top + r.height / 2 - centre);
              const t = Math.min(1, Math.max(0, 1 - d / ramp));
              const ease = t * t * (3 - 2 * t); // smoothstep
              line.style.opacity = (GHOST + (1 - GHOST) * ease).toFixed(3);
            }
          };
          let whatTick = false;
          const onWhatScroll = () => {
            if (whatTick) return;
            whatTick = true;
            requestAnimationFrame(() => { whatTick = false; updateWhat(); });
          };
          window.addEventListener('scroll', onWhatScroll, { passive: true });
          window.addEventListener('resize', onWhatScroll, { passive: true });
          updateWhat();
        }
      }
    }
    // Scroll Split Card — the wide image separates into three panels and
    // flips to the mission cards as you scroll. One spring-smoothed progress
    // value drives the stages: 0-0.4 separation, 0.4-0.8 flip, 0.8-1 finale.
    const splitTrack = document.querySelector('[data-split-track]');
    const reducedMotionSplit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (splitTrack && !reducedMotionSplit) {
      const splitPanels = Array.from(splitTrack.querySelectorAll('[data-split-panel]'));
      const splitRow = splitTrack.querySelector('[data-split-row]');
      const splitEndline = splitTrack.querySelector('[data-split-endline]');
      if (splitRow && splitPanels.length) {
        const clamp01 = (v) => Math.max(0, Math.min(1, v));
        const lerp = (a, b, t) => a + (b - a) * t;
        const seg = (p, a, b) => clamp01((p - a) / (b - a));
        const RAD = 16;

        const applySplit = (p) => {
          const sep = seg(p, 0, 0.4);
          const clos = seg(p, 0.4, 0.8);
          const fin = seg(p, 0.8, 1);
          const settle = seg(p, 0, 0.2);

          const lx = sep * -48 + clos * 24;
          const rx = sep * 48 - clos * 24;
          const scale = lerp(1, 0.9, sep);
          const rotY = clos * 180;
          const shadowOp = 0.4 * settle;
          const shadow = `inset 0 1px 1px rgba(255,255,255,${(0.2 * settle).toFixed(3)}), inset 0 -24px 48px rgba(0,0,0,${shadowOp.toFixed(3)}), 0 25px 50px -12px rgba(0,0,0,${shadowOp.toFixed(3)})`;
          const rad = (RAD * settle).toFixed(1);

          splitRow.style.transform = `translate3d(0,${(fin * -200).toFixed(1)}px,0) scale(${scale.toFixed(4)})`;
          if (splitEndline) {
            splitEndline.style.opacity = fin.toFixed(3);
            splitEndline.style.transform = `translate3d(0,${(40 - fin * 40).toFixed(1)}px,0)`;
          }

          for (const panel of splitPanels) {
            const i = parseInt(panel.dataset.splitIndex, 10);
            const face = panel.querySelector('.split-front');
            const back = panel.querySelector('.split-back');
            const x = i === 0 ? lx : i === 2 ? rx : 0;
            const rz = i === 0 ? clos * 6 : i === 2 ? clos * -6 : 0;
            panel.style.transform = `translate3d(${x.toFixed(2)}px,0,0) rotateY(${rotY.toFixed(2)}deg) rotateZ(${rz.toFixed(2)}deg)`;
            let radius;
            if (i === 0) radius = `${RAD}px ${rad}px ${rad}px ${RAD}px`;
            else if (i === 2) radius = `${rad}px ${RAD}px ${RAD}px ${rad}px`;
            else radius = `${rad}px`;
            if (face) { face.style.borderRadius = radius; face.style.boxShadow = shadow; }
            if (back) back.style.borderRadius = radius;
          }
        };

        const updateSplit = () => {
          const rect = splitTrack.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          applySplit(clamp01(-rect.top / Math.max(total, 1)));
        };

        // Direct scroll mapping — no animation loop: the transform is a pure
        // function of scroll position, so it can never stall on rAF.
        window.addEventListener('scroll', updateSplit, { passive: true });
        window.addEventListener('resize', updateSplit);
        updateSplit();
      }
    }
  </script>

</Page>

<style>
/* HERO */
.hi-hero {
  padding: clamp(80px,10vw,130px) 0 clamp(56px,8vw,96px);
  position: relative;
  overflow: hidden;
  background: transparent;
}
.hi-hero .shell { position: relative; z-index: 1; }
.hi-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 15% 50%, rgba(42, 108, 245, 0.06) 0%, transparent 55%);
  pointer-events: none;
}

@keyframes heroFadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Reflection-style hero entrance: plays on its own from page load. */
