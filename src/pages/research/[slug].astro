---
import { readFileSync } from 'node:fs'
import Page from '../../components/Page.astro'
import { allPublications, bibtex, formatDate } from '../../lib/research.js'

export function getStaticPaths() { return allPublications.map((publication) => ({ params: { slug: publication.slug }, props: { publication } })) }
const { publication } = Astro.props
const articleHtml = readFileSync(new URL(`../../content/research/${publication.slug}.html`, import.meta.url), 'utf8')
  .replace(/<h1\b/gi, '<h2')
  .replace(/<\/h1>/gi, '</h2>')
  .replace(/<img(?![^>]*\balt=)/gi, '<img alt=""')
const citation = bibtex(publication)
const articleUrl = `https://jhelumlabs.in/research/${publication.slug}`
const jsonLd = { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', headline: publication.title, author: publication.authors.map((name) => ({ '@type': 'Organization', name })), datePublished: publication.date, abstract: publication.abstract, url: articleUrl, publisher: { '@type': 'Organization', name: 'Jhelum Labs', url: 'https://jhelumlabs.in' } }
---
<Page currentPath="/research" title={`${publication.title} — Jhelum Labs`} description={publication.abstract} canonical={`/research/${publication.slug}`} jsonLd={jsonLd}>
  <article class="article shell"><a href="/research">← All research</a><header class="article-header"><p class="eyebrow">{publication.type}</p><h1>{publication.title}</h1><div class="article-meta"><span>{publication.authors.join(', ')}</span><time datetime={publication.date}>{formatDate(publication.date)}</time><span class="status">{publication.status}</span></div><p class="abstract">{publication.abstract}</p></header><div class="article-grid"><div class="article-content"><h2>Abstract</h2><p class="abstract">{publication.abstract}</p><div set:html={articleHtml} /></div><aside><div class="aside-card"><h2>Publication details</h2><p><strong>Authors</strong><br />{publication.authors.join(', ')}</p><p><strong>Date</strong><br />{formatDate(publication.date)}</p><p><strong>Status</strong><br />{publication.status}</p>{publication.pdf ? <a class="button button-small" href={publication.pdf} download>Download PDF</a> : <p>PDF download: TODO — no verified PDF is in the repository.</p>}</div><div class="aside-card cite"><h2>Cite this</h2><pre>{citation}</pre><button class="copy" type="button" data-copy={citation}>Copy BibTeX</button></div></aside></div></article>
</Page>
