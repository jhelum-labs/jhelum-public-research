---
import Page from '../../components/Page.astro'
import { allPublications, formatDate, publicationTypes } from '../../lib/research.js'

const requestedType = Astro.url.searchParams.get('type')
const type = publicationTypes.includes(requestedType) ? requestedType : 'All'
const publications = type === 'All' ? allPublications : allPublications.filter((p) => p.type === type)

const typeLabel = (t) => {
  if (t === 'Research Paper') return 'Research'
  if (t === 'Production Document') return 'Production'
  return t
}
---
<Page currentPath="/research" title="Research — Jhelum Labs" description="Research papers and production documentation from Jhelum Labs.">

  <div class="rp shell">

    <!-- ── Title + filter tabs — exact OpenAI research style ── -->
    <header class="rp-head">
      <h1 class="rp-title">Research</h1>
      <nav class="rp-filters" aria-label="Filter by type">
        {['All', 'Research Paper', 'Production Document'].map((item) => (
          <a
            class={type === item ? 'rp-tab rp-tab--active' : 'rp-tab'}
            href={item === 'All' ? '/research' : `/research?type=${encodeURIComponent(item)}`}
          >
            {typeLabel(item)}
          </a>
        ))}
      </nav>
    </header>

    <!-- ── Publication list — OpenAI style rows ── -->
    <div class="rp-list">
      {publications.map((pub) => (
        <a class="rp-row" href={pub.articlePath}>
          <div class="rp-row-left">
            <span class="rp-row-type">{typeLabel(pub.type)}</span>
            <time class="rp-row-date">{formatDate(pub.date)}</time>
          </div>
          <div class="rp-row-body">
            <h2 class="rp-row-title">{pub.title}</h2>
            <p class="rp-row-excerpt">{pub.abstract}</p>
          </div>
        </a>
      ))}
    </div>

  </div>

</Page>

<style>
.rp {
  padding: clamp(56px,8vw,96px) 0 clamp(72px,10vw,120px);
}

/* ── Head ── */
.rp-head {
  margin-bottom: 0;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.rp-title {
  font-size: clamp(1.8rem, 3.5vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--text);
  margin: 0;
  line-height: 1.1;
}

/* Filter tabs — OpenAI style (minimal, no pills, just text links) */
.rp-filters {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}
.rp-tab {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border-radius: 6px;
  font-size: .88rem;
  font-weight: 500;
  color: var(--text-soft);
  text-decoration: none;
  border: 1px solid transparent;
  transition: color .15s ease, background .15s ease, border-color .15s ease;
}
.rp-tab:hover {
  color: var(--text);
  background: var(--surface-2);
}
.rp-tab--active {
  color: var(--text);
  background: var(--surface-2);
  border-color: var(--line-hover);
  font-weight: 600;
}

/* ── Publication rows — exact OpenAI research index style ── */
.rp-list {
  display: flex;
  flex-direction: column;
}

.rp-row {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 32px;
  align-items: start;
  padding: 28px 0;
  border-bottom: 1px solid var(--line);
  text-decoration: none;
  transition: opacity .15s ease;
}

.rp-row:hover .rp-row-title {
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* Left column: type + date */
.rp-row-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-top: 3px;
}
.rp-row-type {
  font-size: .84rem;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -.01em;
}
.rp-row-date {
  font-size: .82rem;
  color: var(--muted);
}

/* Right column: title + excerpt */
.rp-row-body {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.rp-row-title {
  font-size: clamp(1rem, 1.8vw, 1.3rem);
  font-weight: 700;
  letter-spacing: -.02em;
  color: var(--text);
  margin: 0;
  line-height: 1.3;
  transition: color .15s;
}
.rp-row-excerpt {
  font-size: .88rem;
  color: var(--text-soft);
  line-height: 1.6;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ══ Responsive ══ */
@media (max-width: 700px) {
  .rp-head { flex-direction: column; align-items: flex-start; gap: 16px }
  .rp-row { grid-template-columns: 1fr; gap: 6px }
  .rp-row-left { flex-direction: row; align-items: center; gap: 12px }
  .rp-row-date { font-size: .76rem }
}
</style>
