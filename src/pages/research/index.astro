---
import Page from '../../components/Page.astro'
import { allPublications, formatDate, publicationStats, publicationTypes } from '../../lib/research.js'

const stats = publicationStats()
const requestedType = Astro.url.searchParams.get('type')
const type = publicationTypes.includes(requestedType) ? requestedType : 'All'
const publications = type === 'All' ? allPublications : allPublications.filter((publication) => publication.type === type)
---
<Page currentPath="/research" title="Research — Jhelum Labs" description="Research papers and production documentation from Jhelum Labs, including the W-1.1 model program.">
  <section class="research-page shell">
    <header class="research-intro">
      <p class="section-eyebrow">Jhelum Labs</p>
      <h1>Research</h1>
      <p>A record of research papers and production documentation from the W-1.1 model program.</p>
    </header>
    <div class="research-summary" aria-label="Publication statistics"><span>{stats.total} publications</span><span>{stats.papers} research papers</span><span>{stats.documents} production docs</span></div>
    <nav class="filters" aria-label="Filter publications by type">
      {publicationTypes.map((item) => <a class={type === item ? 'active' : ''} href={item === 'All' ? '/research' : `/research?type=${encodeURIComponent(item)}`}>{item === 'All' ? 'All' : item.replace(' Document', ' docs')}</a>)}
    </nav>
    <div class="publication-list">
      {publications.map((publication) => <a class="publication-row" href={publication.articlePath}>
        <div class="publication-meta"><strong>{publication.type}</strong><time datetime={publication.date}>{formatDate(publication.date)}</time></div>
        <div><h2>{publication.title}</h2><p>{publication.abstract}</p><p class="publication-authors">{publication.authors.join(', ')}</p></div>
        <span class="publication-arrow" aria-hidden="true">↗</span>
      </a>)}
    </div>
  </section>
</Page>
