---
import Page from '../../components/Page.astro'
import { allPublications, formatDate, publicationStats, publicationTypes } from '../../lib/research.js'
const type = Astro.url.searchParams.get('type') || 'All'
const publications = type === 'All' ? allPublications : allPublications.filter((publication) => publication.type === type)
const stats = publicationStats()
---
<Page currentPath="/research" title="Research — Jhelum Labs" description="Research papers and production documentation from Jhelum Labs, including the published W-1.1 model program."><section class="research-page shell"><header><p class="eyebrow">Jhelum Labs</p><h1 class="page-title">Research</h1><p class="abstract">A record of published research papers and production documentation. W-1.1 is Jhelum Labs’ only published model program.</p></header><div class="stats"><div class="stat"><strong>{stats.total}</strong><span>Publications</span></div><div class="stat"><strong>{stats.papers}</strong><span>Research papers</span></div><div class="stat"><strong>{stats.documents}</strong><span>Production docs</span></div></div><div class="filters" aria-label="Filter publications by type"><a class={type === 'All' ? 'active' : ''} href="/research">All</a>{publicationTypes.slice(1).map((item) => <a class={type === item ? 'active' : ''} href={`/research?type=${encodeURIComponent(item)}`}>{item}</a>)}</div><div class="publication-list">{publications.map((publication) => <a class="publication-row" href={publication.articlePath}><div class="publication-meta"><strong>{publication.type}</strong><time datetime={publication.date}>{formatDate(publication.date)}</time></div><div><h2>{publication.title}</h2><p>{publication.abstract}</p><p class="publication-meta">{publication.authors.join(', ')} · {publication.status}</p></div><span class="publication-arrow" aria-hidden="true">↗</span></a>)}</div></section></Page>
