---
import Page from '../components/Page.astro'
import { SITE } from '../lib/site.js'
---
<Page currentPath="/models" title="Models — Jhelum Labs" description="The published W-1.1 model program from Jhelum Labs.">
  <section class="models-page shell">
    <header class="models-intro">
      <p class="section-eyebrow">Jhelum Labs</p>
      <h1>Models</h1>
      <p>Published model programs and their supporting research record.</p>
    </header>

    <article class="model-feature">
      <div class="model-visual" aria-hidden="true"><img src="/research-covers/architecture.svg" alt="" width="1200" height="800" /></div>
      <div class="model-copy">
        <p class="section-eyebrow">Published model program</p>
        <h2>W-1.1</h2>
        <p>W-1.1 is Jhelum Labs’ published language-model research program. Its architecture, training work, testing, and production documentation are available in the public research record.</p>
        <div class="model-actions"><a class="button" href="/research">Read W-1.1 research</a>{SITE.weightsUrl && <a class="button button-quiet" href={SITE.weightsUrl}>Model weights</a>}</div>
      </div>
    </article>

    <section class="model-details" aria-label="W-1.1 documentation">
      <div><h2>Documentation</h2><p>Architecture, experiments, and engineering reports are published as research documents.</p></div>
      <a class="text-link" href="/research?type=Research%20Paper">Browse research papers <span aria-hidden="true">↗</span></a>
    </section>
  </section>
</Page>
