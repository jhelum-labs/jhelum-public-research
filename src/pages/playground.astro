---
import Page from '../components/Page.astro'
import { SITE } from '../lib/site.js'
const weightsUrl = 'https://github.com/wasif-ali-ganie/origin-labs-w-1.1/releases/download/v1.0.0/w-1.1.safetensors'
const repositoryUrl = 'https://github.com/jhelum-labs/w-1.1'
---
<Page currentPath="" title="W-1.1 — Jhelum Labs" description="W-1.1 is the published Jhelum Labs model program. Find its research record and verified project links."><section class="page shell prose"><p class="eyebrow">{SITE.tagline}</p><h1 class="page-title">W-1.1</h1><p>W-1.1 is Jhelum Labs’ only published model program. It is an experimental research model; consult the documentation and limitations before use.</p><p><a class="button" href={weightsUrl}>Download W-1.1 weights</a> <a class="button button-small" href={repositoryUrl}>Project repository</a></p><h2>Research record</h2><p><a href="/research">Read the W-1.1 publications</a> for architecture, experiment, and production documentation.</p></section></Page>
