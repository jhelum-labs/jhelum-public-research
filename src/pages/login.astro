---
import Page from '../components/Page.astro'
---
<Page currentPath="/login" title="Log In — Jhelum Labs" description="Log in to access Jhelum Labs research portal, model documentation, and experimental tools.">
  <section class="auth-page">
    <div class="auth-container">
      
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-hero-badge">Research Portal</div>
          <h1 class="auth-title">Log in</h1>
          <p class="auth-subtitle">Access your account, model weights, and research notes</p>
        </div>

        <!-- Alert messages container -->
        <div id="authAlert" class="auth-alert" style="display: none;" role="alert">
          <span id="alertIcon"></span>
          <span id="alertText"></span>
        </div>

        <!-- Configuration helper banner (shown when .env is not yet configured) -->
        <div id="configNotice" class="auth-alert auth-alert-info" style="display: none;">
          <div>
            <strong>Setup Notice:</strong> Firebase credentials not detected in <code>.env</code>.
            <button type="button" id="openSetupModal">Click here for setup instructions</button>
          </div>
        </div>

        <!-- Google OAuth Button -->
        <button type="button" class="btn-google-auth" id="btnGoogleLogin">
          <svg class="google-icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
          <span id="googleBtnText">Continue with Google</span>
        </button>

        <div class="auth-divider">or continue with email</div>

        <!-- Email & Password Form -->
        <form class="auth-form" id="loginForm" novalidate>
          <div class="form-group">
            <label class="form-label" for="loginEmail">Email address</label>
            <input
              type="email"
              id="loginEmail"
              name="email"
              class="form-input"
              placeholder="name@organization.com"
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <div class="form-label-row">
              <label class="form-label" for="loginPassword">Password</label>
              <button type="button" class="form-forgot-link" id="btnForgotPassword">Forgot password?</button>
            </div>
            <input
              type="password"
              id="loginPassword"
              name="password"
              class="form-input"
              placeholder="••••••••"
              required
              autocomplete="current-password"
            />
          </div>

          <!-- Password Reset Box (toggled via Forgot password?) -->
          <div id="resetPasswordBox" style="display: none; padding: 12px; background: var(--surface-2); border-radius: 8px; border: 1px solid var(--line);">
            <p style="margin: 0 0 8px; font-size: 0.82rem; color: var(--text-soft);">
              Enter your email above and click below to receive a password reset link.
            </p>
            <button type="button" id="btnSendReset" class="btn-pill-dark" style="font-size: 0.9rem; padding: 8px 18px;">
              Send reset link
            </button>
          </div>

          <!-- Exact Dark Pill Submit Button from Reference Image -->
          <button type="submit" class="btn-pill-signup btn-pill-block" id="btnLoginSubmit">
            <span id="submitBtnText">Log in</span>
          </button>
        </form>

        <div class="auth-footer">
          Don't have an account? <a href="/signup">Sign up</a>
        </div>
      </div>

    </div>
  </section>

  <!-- Modal explaining .env setup if Firebase keys are not provided -->
  <div id="setupModal" class="config-modal-backdrop" style="display: none;">
    <div class="config-modal">
      <h3>Firebase Authentication Setup</h3>
      <p style="font-size: 0.9rem; color: var(--text-soft); line-height: 1.5;">
        To activate real Google Sign-In and Email authentication, create a <code>.env</code> file in your project root (which is automatically ignored by Git) with your Firebase credentials:
      </p>
      <pre class="config-code-block"><code>PUBLIC_FIREBASE_API_KEY="AIzaSy..."
PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"</code></pre>
      <p style="font-size: 0.85rem; color: var(--muted);">
        A pre-formatted template is available in <code>.env.example</code>. Once saved, restart the dev server.
      </p>
      <div style="text-align: right; margin-top: 18px;">
        <button type="button" id="closeSetupModal" class="btn-pill-dark" style="font-size: 0.95rem; padding: 8px 22px;">Got it</button>
      </div>
    </div>
  </div>
</Page>

<script>
  import {
    isFirebaseConfigured,
    signInWithGoogle,
    logInWithEmail,
    sendResetPassword,
    getCachedUser
  } from '../lib/auth.js'

  const alertEl = document.getElementById('authAlert')
  const alertText = document.getElementById('alertText')
  const configNotice = document.getElementById('configNotice')
  const setupModal = document.getElementById('setupModal')
  const openSetupModal = document.getElementById('openSetupModal')
  const closeSetupModal = document.getElementById('closeSetupModal')

  const loginForm = document.getElementById('loginForm') as HTMLFormElement
  const loginEmail = document.getElementById('loginEmail') as HTMLInputElement
  const loginPassword = document.getElementById('loginPassword') as HTMLInputElement
  const btnGoogleLogin = document.getElementById('btnGoogleLogin') as HTMLButtonElement
  const btnLoginSubmit = document.getElementById('btnLoginSubmit') as HTMLButtonElement
  const submitBtnText = document.getElementById('submitBtnText')
  const googleBtnText = document.getElementById('googleBtnText')

  const btnForgotPassword = document.getElementById('btnForgotPassword')
  const resetPasswordBox = document.getElementById('resetPasswordBox')
  const btnSendReset = document.getElementById('btnSendReset')

  // Check if Firebase is configured
  const configured = isFirebaseConfigured()
  if (!configured && configNotice) {
    configNotice.style.display = 'flex'
  }

  // If already logged in, notify user
  const currentUser = getCachedUser()
  if (currentUser) {
    showAlert('info', `You are currently signed in as ${currentUser.email}. Redirecting...`)
    setTimeout(() => {
      window.location.href = '/'
    }, 1500)
  }

  function showAlert(type: 'error' | 'success' | 'info', message: string) {
    if (!alertEl || !alertText) return
    alertEl.style.display = 'flex'
    alertEl.className = `auth-alert auth-alert-${type}`
    alertText.textContent = message
  }

  function hideAlert() {
    if (alertEl) alertEl.style.display = 'none'
  }

  function setSubmitting(loading: boolean, text: string = 'Logging in...') {
    if (btnLoginSubmit && submitBtnText) {
      btnLoginSubmit.disabled = loading
      submitBtnText.innerHTML = loading ? `<span class="spinner"></span> ${text}` : 'Log in'
    }
    if (btnGoogleLogin) {
      btnGoogleLogin.disabled = loading
    }
  }

  // Setup modal handlers
  openSetupModal?.addEventListener('click', () => {
    if (setupModal) setupModal.style.display = 'flex'
  })
  closeSetupModal?.addEventListener('click', () => {
    if (setupModal) setupModal.style.display = 'none'
  })
  setupModal?.addEventListener('click', (e) => {
    if (e.target === setupModal) setupModal.style.display = 'none'
  })

  // Google OAuth Login
  btnGoogleLogin?.addEventListener('click', async () => {
    hideAlert()
    if (!isFirebaseConfigured()) {
      if (setupModal) setupModal.style.display = 'flex'
      showAlert('info', 'Please add your Firebase credentials to .env to enable real Google Sign-In.')
      return
    }

    try {
      if (googleBtnText) googleBtnText.innerHTML = '<span class="spinner"></span> Connecting to Google...'
      btnGoogleLogin.disabled = true
      await signInWithGoogle()
      showAlert('success', 'Successfully logged in with Google! Redirecting...')
      setTimeout(() => {
        const params = new URLSearchParams(window.location.search)
        window.location.href = params.get('redirect') || '/'
      }, 700)
    } catch (err: any) {
      console.error('Google Sign-In Error:', err)
      if (googleBtnText) googleBtnText.textContent = 'Continue with Google'
      btnGoogleLogin.disabled = false

      if (err.code === 'auth/popup-closed-by-user') {
        showAlert('error', 'Google sign-in popup was closed before completing.')
      } else if (err.code === 'auth/unauthorized-domain') {
        showAlert('error', 'This domain is not authorized in your Firebase Console (Authentication > Settings > Authorized domains).')
      } else {
        showAlert('error', err.message || 'Failed to sign in with Google.')
      }
    }
  })

  // Email & Password Login
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    hideAlert()

    const email = loginEmail.value.trim()
    const password = loginPassword.value

    if (!email || !password) {
      showAlert('error', 'Please enter both email and password.')
      return
    }

    if (!isFirebaseConfigured()) {
      if (setupModal) setupModal.style.display = 'flex'
      showAlert('info', 'Please configure your Firebase credentials in .env to enable authentication.')
      return
    }

    try {
      setSubmitting(true, 'Verifying...')
      await logInWithEmail(email, password)
      showAlert('success', 'Logged in successfully! Redirecting...')
      setTimeout(() => {
        const params = new URLSearchParams(window.location.search)
        window.location.href = params.get('redirect') || '/'
      }, 700)
    } catch (err: any) {
      setSubmitting(false)
      console.error('Login error:', err)
      if (err.code === 'auth/invalid-credential' || err.code === 'auth/user-not-found' || err.code === 'auth/wrong-password') {
        showAlert('error', 'Invalid email or password. Please try again.')
      } else if (err.code === 'auth/too-many-requests') {
        showAlert('error', 'Access to this account has been temporarily disabled due to many failed login attempts.')
      } else {
        showAlert('error', err.message || 'Login failed. Please try again.')
      }
    }
  })

  // Forgot password toggle
  btnForgotPassword?.addEventListener('click', () => {
    if (resetPasswordBox) {
      resetPasswordBox.style.display = resetPasswordBox.style.display === 'none' ? 'block' : 'none'
    }
  })

  // Send Reset Email
  btnSendReset?.addEventListener('click', async () => {
    const email = loginEmail.value.trim()
    if (!email) {
      showAlert('error', 'Please enter your email address in the field above first.')
      return
    }
    if (!isFirebaseConfigured()) {
      showAlert('info', 'Configure Firebase credentials in .env to enable password resets.')
      return
    }
    try {
      btnSendReset.textContent = 'Sending...'
      await sendResetPassword(email)
      showAlert('success', `Password reset instructions sent to ${email}.`)
      btnSendReset.textContent = 'Sent!'
      setTimeout(() => { btnSendReset.textContent = 'Send reset link' }, 3000)
    } catch (err: any) {
      btnSendReset.textContent = 'Send reset link'
      showAlert('error', err.message || 'Unable to send password reset email.')
    }
  })
</script>
