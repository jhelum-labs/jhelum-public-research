---
import { SITE, pageDescription } from '../lib/site.js'
import '../styles/site.css'
import '../styles/auth.css'

const { title = SITE.name, description = pageDescription, image = '/social-card.png', canonical, jsonLd } = Astro.props
const canonicalUrl = new URL(canonical || Astro.url.pathname, SITE.url).href
const imageUrl = new URL(image, SITE.url).href
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090b10" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Poppins:wght@500;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Poppins:wght@500;700&display=swap" rel="stylesheet" /></noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — research and development`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={`${SITE.name} — research and deployment`} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Three choices: light, dark (slate), absolute-dark (pure black).
      // Absolute-dark keeps data-theme='dark' so every dark-mode rule and
      // swapped asset keeps working, and adds .theme-absolute for the
      // pure-black token overrides.
      try {
        var __t = localStorage.getItem('jl-theme')
        if (__t !== 'light' && __t !== 'dark' && __t !== 'absolute-dark') {
          __t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
        }
        document.documentElement.dataset.theme = __t === 'light' ? 'light' : 'dark'
        document.documentElement.classList.toggle('theme-absolute', __t === 'absolute-dark')
        document.documentElement.dataset.themeChoice = __t
      } catch { document.documentElement.dataset.theme = 'dark' }
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      document.querySelectorAll('[data-menu-button]')?.forEach((b) => b.addEventListener('click', () => document.documentElement.classList.toggle('menu-open')))
      // Theme model: three choices with a dropdown on the theme button.
      const applyTheme = (choice) => {
        document.documentElement.dataset.theme = choice === 'light' ? 'light' : 'dark'
        document.documentElement.classList.toggle('theme-absolute', choice === 'absolute-dark')
        document.documentElement.dataset.themeChoice = choice
        try { localStorage.setItem('jl-theme', choice) } catch {}
      }
      const markThemeOptions = () => {
        const choice = document.documentElement.dataset.themeChoice || document.documentElement.dataset.theme
        document.querySelectorAll('[data-theme-option]').forEach((o) => {
          const on = o.getAttribute('data-theme-option') === choice
          o.classList.toggle('is-active', on)
          o.setAttribute('aria-checked', on ? 'true' : 'false')
        })
      }
      const closeThemeMenus = () => {
        document.querySelectorAll('[data-theme-list]').forEach((l) => { l.setAttribute('hidden', '') })
        document.querySelectorAll('[data-theme-menu-button]').forEach((b) => b.setAttribute('aria-expanded', 'false'))
      }
      document.querySelectorAll('[data-theme-menu-button]')?.forEach((b) => b.addEventListener('click', (e) => {
        e.stopPropagation()
        const list = b.closest('[data-theme-menu]')?.querySelector('[data-theme-list]')
        if (!list) return
        const wasOpen = !list.hasAttribute('hidden')
        closeThemeMenus()
        if (!wasOpen) { list.removeAttribute('hidden'); b.setAttribute('aria-expanded', 'true') }
      }))
      document.querySelectorAll('[data-theme-option]')?.forEach((b) => b.addEventListener('click', () => {
        applyTheme(b.getAttribute('data-theme-option'))
        markThemeOptions()
        closeThemeMenus()
      }))
      markThemeOptions()
      document.addEventListener('click', (e) => { if (!e.target.closest('[data-theme-menu]')) closeThemeMenus() })
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeThemeMenus() })
      document.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', async () => { try { await navigator.clipboard.writeText(button.dataset.copy); button.textContent = 'Copied' } catch { button.textContent = 'Copy unavailable' } }))

      // Paper diagrams are flat vector-style artwork, so they ship twice: the
      // original light plate and a recoloured build whose grounds and strokes
      // are the site's own dark tokens. Swap the file when the theme changes
      // rather than filtering one image, which would tint the box colours.
      // The markup carries only the light file; the dark one is derived here.
      const syncFigureTheme = () => {
        const dark = document.documentElement.dataset.theme === 'dark'
        document.querySelectorAll('.article-figure img').forEach((img) => {
          if (!img.dataset.light) {
            const current = img.getAttribute('src')
            if (!current || !current.endsWith('.png')) return
            img.dataset.light = current
            img.dataset.dark = current.replace(/\.png$/, '-dark.png')
          }
          const want = dark ? img.dataset.dark : img.dataset.light
          if (img.getAttribute('src') !== want) img.setAttribute('src', want)
        })
      }
      syncFigureTheme()
      new MutationObserver(syncFigureTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })

      // Scroll-reveal: fade/slide elements in as they enter the viewport.
      const revealEls = document.querySelectorAll('[data-scroll-reveal]')
      if (revealEls.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed')
              io.unobserve(entry.target)
            }
          })
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' })
        revealEls.forEach((el) => io.observe(el))
      } else {
        revealEls.forEach((el) => el.classList.add('is-revealed'))
      }

      // Image lightbox: click any article image to zoom.
      const openLightbox = (src, alt) => {
        const overlay = document.createElement('div')
        overlay.className = 'lightbox-overlay'
        overlay.innerHTML = '<button class="lightbox-close" aria-label="Close">&times;</button><img alt="" />'
        const img = overlay.querySelector('img')
        img.src = src
        img.alt = alt || ''
        document.body.appendChild(overlay)
        requestAnimationFrame(() => overlay.classList.add('is-open'))
        const close = () => {
          overlay.classList.remove('is-open')
          setTimeout(() => overlay.remove(), 300)
        }
        overlay.addEventListener('click', close)
        overlay.querySelector('.lightbox-close').addEventListener('click', (e) => { e.stopPropagation(); close() })
        const onKey = (e) => { if (e.key === 'Escape') { close(); document.removeEventListener('keydown', onKey) } }
        document.addEventListener('keydown', onKey)
      }
      document.querySelectorAll('main img').forEach((img) => {
        if (img.closest('header, nav, footer')) return
        if (img.width < 80 && img.height < 80) return
        img.style.cursor = 'zoom-in'
        img.addEventListener('click', () => openLightbox(img.src, img.alt))
      })
    </script>
  </body>
</html>
